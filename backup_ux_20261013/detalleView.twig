{% include 'includes/admin/inventory-top.twig' %}
<link href="{{ get_base_url() }}assets/css/traspasos-detalle.css?v={{ get_asset_version() }}" rel="stylesheet">
{% set document_status_labels = {'DISPONIBLE':'Disponible e íntegro','AUSENTE':'Ausente','RUTA_INVALIDA':'Ruta inválida','HASH_INVALIDO':'Integridad inconsistente','TAMANO_INVALIDO':'Integridad inconsistente','NO_VERIFICABLE':'Integridad no verificada','ERROR_LECTURA':'Lectura no disponible'} %}
{% set document_status_classes = {'DISPONIBLE':'available','AUSENTE':'missing','RUTA_INVALIDA':'invalid','HASH_INVALIDO':'inconsistent','TAMANO_INVALIDO':'inconsistent','NO_VERIFICABLE':'unverified','ERROR_LECTURA':'unavailable'} %}
<div class="transfer-page transfer-detail">
  <nav class="bi-breadcrumbs" aria-label="Ruta de navegación"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="{{ get_base_url() }}admin">Inicio</a></li><li class="breadcrumb-item">Documentos y movimientos</li><li class="breadcrumb-item"><a href="{{ get_base_url() }}traspasos">Traspasos</a></li><li class="breadcrumb-item active" aria-current="page">Detalle del resguardo</li></ol></nav>
  <header class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <div>
      <h1 class="h3 bi-title mb-1">{{ traspaso.entre_unidades ? 'Traspaso entre área' : 'Traspaso en la misma área' }}</h1>
      <p class="text-muted mb-0">Número del traspaso: <strong>{{ traspaso.folio }}</strong> <span class="transfer-status transfer-status--compact ms-2" data-bs-toggle="tooltip" data-bs-placement="top" title="{{ traspaso.estado_tooltip }}" aria-label="{{ traspaso.estado_tooltip }}">Estado patrimonial: {{ traspaso.estado|replace({'_':' '})|title }}</span></p>
    </div>
    <a class="btn btn-sm btn-outline-dark" href="{{ get_base_url() }}traspasos"><i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>Volver a Traspasos</a>
  </header>

  <div class="row g-4">
    <div class="col-12">
      <section class="card border-0 shadow-sm mb-4" aria-labelledby="transferInfoTitle">
        <div class="card-header bg-white"><h2 id="transferInfoTitle" class="h5 mb-0">1. Información del traspaso</h2></div>
        <div class="card-body">
          <div class="row g-2 transfer-info-grid">
            <div class="col-lg-4 col-md-6"><strong class="d-block">Origen</strong>{{ traspaso.unidad_origen_nombre }}<small class="d-block text-muted">{{ traspaso.unidad_origen_codigo|default('Código UA no registrado') }}</small></div>
            <div class="col-lg-4 col-md-6"><strong class="d-block">Destino</strong>{{ traspaso.unidad_destino_nombre }}<small class="d-block text-muted">{{ traspaso.unidad_destino_codigo|default('Código UA no registrado') }}</small></div>
            <div class="col-lg-4 col-md-6"><strong class="d-block">Resguardante origen</strong>{{ traspaso.bienes|length ? traspaso.bienes[0].resguardante_origen_nombre|default('No aplica') : 'No aplica' }}<small class="d-block text-muted">CSP: {{ traspaso.bienes|length ? traspaso.bienes[0].resguardante_origen_csp|default('No registrado') : 'No aplica' }}</small></div>
            <div class="col-lg-4 col-md-6"><strong class="d-block">Resguardante destino</strong>{{ traspaso.resguardante_destino_nombre }}<small class="d-block text-muted">CSP: {{ traspaso.resguardante_destino_csp|default('No registrado') }}</small></div>
            <div class="col-lg-4 col-md-6"><strong class="d-block">Motivo origen</strong><span class="transfer-readonly-value">{{ traspaso.motivo|default('No aplica') }}</span></div>
            <div class="col-lg-4 col-md-6"><strong class="d-block">Observaciones</strong><span class="transfer-readonly-value">{{ traspaso.observaciones|default('No aplica') }}</span></div>
          </div>
        </div>
      </section>

      <section class="card border-0 shadow-sm mb-4" aria-labelledby="transferGoodsTitle">
        <div class="card-header bg-white d-flex justify-content-between align-items-center"><h2 id="transferGoodsTitle" class="h5 mb-0">Bienes incluidos</h2><span class="badge text-bg-light">{{ traspaso.bienes|length }}</span></div>
        <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>CI / Inventario</th><th>Bien</th><th>Resguardante anterior</th><th>Ubicación destino</th></tr></thead><tbody>
          {% for item in traspaso.bienes %}<tr><td>{{ item.clave_interna }}<small class="d-block text-muted">{{ item.numero_inventario|default('') }}</small></td><td>{{ item.nombre_bien }}<small class="d-block text-muted">{{ item.numero_serie|default('') }}</small></td><td>{{ item.resguardante_origen_nombre|default('Sin resguardante') }}<small class="d-block text-muted">{{ item.resguardante_origen_csp|default('') }}</small></td><td>{% if item.ubicacion_sin_cambio %}{{ item.municipio_actual|default('') }}{% if item.localidad_actual %} — {{ item.localidad_actual }}{% endif %}{% else %}{{ item.municipio_destino|default('') }}{% if item.localidad_destino %} — {{ item.localidad_destino }}{% endif %}{% endif %}</td></tr>{% endfor %}
        </tbody></table></div>
      </section>

      {% set summary = traspaso.resumen_documental %}{% set constancia = traspaso.constancias_administrativas|first %}
      {% if summary.anomalias > 0 %}
        <section class="transfer-document-incident mb-4" id="incidencia-documental" aria-labelledby="documentIncidentTitle">
          <header><div><h2 id="documentIncidentTitle" class="h5 mb-1"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> Incidencia documental{% if constancia %} registrada{% else %} histórica{% endif %}</h2><p class="mb-0">Se identificaron {{ summary.anomalias }} documentos registrados con incidencia. El estado patrimonial del expediente no se ha modificado.</p></div><span class="transfer-document-status transfer-document-status--{{ constancia ? 'reviewed' : 'pending' }}"><i class="fa-solid {{ constancia ? 'fa-file-circle-check' : 'fa-clock' }}" aria-hidden="true"></i>{{ constancia ? 'Actuación registrada' : 'Pendiente de revisión administrativa' }}</span></header>
          <dl class="transfer-document-incident__grid"><div><dt>Expediente</dt><dd>{{ traspaso.folio }}</dd></div><div><dt>Estado patrimonial</dt><dd>{{ traspaso.estado|replace({'_':' '})|title }}</dd></div><div><dt>Documentos registrados</dt><dd>{{ summary.total }}</dd></div><div><dt>Disponibles e íntegros</dt><dd>{{ summary.disponibles }}</dd></div><div><dt>Archivos ausentes</dt><dd>{{ summary.ausentes }}</dd></div><div><dt>Otras anomalías</dt><dd>{{ summary.anomalias - summary.ausentes }}</dd></div><div><dt>Fecha de detección</dt><dd>{{ constancia and constancia.fecha_deteccion ? constancia.fecha_deteccion|date('d/m/Y') : 'No registrada' }}</dd></div><div><dt>Revisión administrativa</dt><dd>{{ constancia ? ('Registrada el ' ~ constancia.fecha_registro|date('d/m/Y H:i')) : 'Sin constancia verificable' }}</dd></div></dl>
          {% if constancia %}<p class="transfer-document-incident__note">Constancia #{{ constancia.id_constancia_administrativa }} · documentos: {{ constancia.documentos_afectados }} · registrada por {{ constancia.registrador_username }}. Esta actuación es actual y no modifica hechos, estados ni evidencias históricas.</p>{% else %}
            <details class="transfer-constancy-draft"><summary>Consultar borrador de constancia administrativa</summary><p>La revisión documenta archivos físicos no disponibles y los resultados técnicos observados. La ausencia de un evento de validación en el sistema no demuestra por sí sola que no existiera una validación externa. No se reconstruyen ni certifican hechos históricos no acreditados.</p></details>
            {% if transfer_permissions['regularizar-documentos'] and traspaso.regularizacion_habilitada %}<form method="post" action="{{ get_base_url() }}traspasos/registrar-constancia-administrativa/{{ traspaso.id_traspaso }}" class="transfer-constancy-form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="return_anchor" value="incidencia-documental"><input type="hidden" name="tipo_incidencia" value="DOCUMENTOS_AUSENTES"><p class="small mb-2">Confirma los identificadores detectados como ausentes. La constancia se registrará con tu identidad y la fecha real del sistema.</p><div class="transfer-constancy-documents">{% for document in traspaso.documentos %}{% if document.archivo_estado == 'AUSENTE' %}<label><input type="checkbox" name="documentos[]" value="{{ document.id_traspaso_documento }}" checked> #{{ document.id_traspaso_documento }} · {{ document.tipo_documento|replace({'_':' '})|title }} · versión {{ document.version }}</label>{% endif %}{% endfor %}</div><div class="row g-2 mt-1"><div class="col-md-4"><label class="form-label small" for="detectionDate">Fecha de detección documentada (opcional)</label><input class="form-control form-control-sm" type="date" id="detectionDate" name="fecha_deteccion"></div><div class="col-md-8"><label class="form-label small" for="resolutionReference">Referencia de resolución o autorización (opcional)</label><input class="form-control form-control-sm" id="resolutionReference" name="referencia_resolucion" maxlength="150"></div></div><button class="btn btn-sm mt-3" type="submit"><i class="fa-solid fa-file-signature" aria-hidden="true"></i> Registrar constancia actual</button></form>{% elseif transfer_permissions['regularizar-documentos'] %}<p class="transfer-document-incident__note">El registro está deshabilitado en este entorno. La constancia permanece disponible sólo para revisión.</p>{% endif %}
          {% endif %}
        </section>
      {% endif %}

      {% if traspaso.entre_unidades %}
        <section class="card border-0 shadow-sm mb-4" id="autorizacion-externa" aria-labelledby="transferOfficeTitle">
          <div class="card-header bg-white"><h2 id="transferOfficeTitle" class="h5 mb-0">2. Autorización externa</h2></div>
          <div class="card-body">
            <p class="small text-muted">La autorización la emite la instancia externa correspondiente. El sistema solamente valida documentalmente que el oficio cargado corresponda al traspaso.</p>
            <div class="row g-3"><div class="col-lg-8">
            {% if traspaso.estado in ['PENDIENTE_VALIDACION','VALIDADO'] and transfer_permissions.subir_documento %}
              <form method="post" enctype="multipart/form-data" action="{{ get_base_url() }}traspasos/subir-documento/{{ traspaso.id_traspaso }}" class="row g-3 align-items-end mb-3"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="return_anchor" value="autorizacion-externa">
                <div class="col-md-4"><label class="form-label" for="transferOfficeNumber">Número de oficio</label><input class="form-control" id="transferOfficeNumber" name="numero_oficio" maxlength="100" required></div>
                <div class="col-md-3"><label class="form-label" for="transferOfficeDate">Fecha del oficio</label><input class="form-control" type="date" id="transferOfficeDate" name="fecha_oficio" required></div>
                <div class="col-md-5"><label class="form-label" for="transferOffice">Cargar o reemplazar oficio (PDF, máximo 15 MB)</label><input class="form-control" type="file" id="transferOffice" name="oficio" accept=".pdf,application/pdf" required></div>
                <div class="col-12"><button class="btn btn-outline-primary" type="submit">Cargar oficio</button></div>
              </form>
            {% endif %}
            {% if traspaso.oficio_actual %}{% set doc = traspaso.oficio_actual %}
              <article class="transfer-document-card mb-3">
                <div class="transfer-file-heading"><span class="transfer-pdf-icon" aria-hidden="true"><i class="fa-solid fa-file-pdf"></i></span><div><strong>{{ doc.nombre_original }}</strong><small class="d-block text-muted">PDF · {{ doc.tamano_legible }} · Oficio {{ doc.metadata.numero_oficio|default('sin número') }} · {{ doc.metadata.fecha_oficio|default('fecha no capturada') }} · Cargado {{ doc.fecha_carga|date('d/m/Y H:i') }}</small></div></div>
                <div class="transfer-actions mt-2">
                  {% if transfer_permissions['descargar-documentos'] and doc.archivo_disponible %}<a class="btn btn-sm" href="{{ get_base_url() }}traspasos/ver-documento/{{ doc.id_traspaso_documento }}" target="_blank" rel="noopener"><i class="fa-regular fa-eye me-1" aria-hidden="true"></i>Ver archivo</a><a class="btn btn-sm" href="{{ get_base_url() }}traspasos/ver-documento/{{ doc.id_traspaso_documento }}" target="_blank" rel="noopener" aria-label="Imprimir oficio" onclick="const pdf=window.open(this.href,'_blank');if(pdf)pdf.addEventListener('load',()=>pdf.print());return false;"><i class="fa-solid fa-print me-1" aria-hidden="true"></i>Imprimir</a><a class="btn btn-sm" href="{{ get_base_url() }}traspasos/descargar-documento/{{ doc.id_traspaso_documento }}"><i class="fa-solid fa-download me-1" aria-hidden="true"></i>Descargar archivo</a>{% endif %}
                  {% if not doc.archivo_disponible %}<p class="transfer-file-unavailable" role="status">Archivo no disponible: {{ doc.archivo_mensaje }}</p>{% endif %}
                </div>
              </article>
            {% endif %}
            {% if not traspaso.tiene_oficio_externo %}<p class="alert alert-warning mb-3">Aún no hay un oficio de autorización en el expediente.</p>{% endif %}
            </div><div class="col-lg-4"><div class="transfer-validation-status h-100"><strong class="d-block mb-2">Estado de validación</strong>
              {% if traspaso.fecha_autorizacion %}<span class="text-success" data-bs-toggle="tooltip" title="Validado por: {{ traspaso.autorizador_username|default('usuario no disponible') }}&#10;Fecha: {{ traspaso.fecha_autorizacion|date('d/m/Y H:i') }}">✓ Oficio Validado</span><small class="d-block">Validado por {{ traspaso.autorizador_username|default('usuario no disponible') }} · {{ traspaso.fecha_autorizacion|date('d/m/Y H:i') }}</small>
              {% else %}<span class="text-warning-emphasis">Pendiente de validar</span>{% endif %}
              {% if traspaso.estado == 'PENDIENTE_VALIDACION' and traspaso.tiene_oficio_externo and is_transfer_authorizer %}<form method="post" action="{{ get_base_url() }}traspasos/autorizar/{{ traspaso.id_traspaso }}" class="mt-3"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="return_anchor" value="autorizacion-externa"><button class="btn btn-sm" type="submit"><i class="fa-solid fa-check me-1" aria-hidden="true"></i>Validar oficio</button></form>{% endif %}
            </div></div></div>
          </div>
        </section>
      {% endif %}

      <section class="card border-0 shadow-sm mb-4" id="documentos-expediente" aria-labelledby="transferDocumentsTitle">
        <div class="card-header bg-white"><h2 id="transferDocumentsTitle" class="h5 mb-0">{{ traspaso.tipo == 'ENTRE_UNIDADES' ? '3' : '2' }}. Documentos del expediente</h2></div>
        <div class="card-body">
          <p class="small text-muted">Los documentos generados pueden revisarse en vista previa PDF. Imprime para recabar firmas manuscritas y digitaliza los formatos firmados; el sistema no registra firmas digitales.</p>
          <p class="small text-muted">La baja documental de resguardante no da de baja el bien en inventario.</p>

          {% if traspaso.hay_versiones_anteriores %}<details class="mb-3"><summary class="fw-semibold">Versiones anteriores del expediente</summary><div class="pt-2">
            {% for doc in traspaso.documentos %}{% if doc.tipo_documento in ['TARJETA_RESGUARDO','RESGUARDO_EQUIPO'] and not doc.id_bien and not doc.es_evidencia %}<article class="transfer-document-card mb-2"><strong>Documento histórico sin asociación por bien · {{ doc.tipo_documento|replace({'_':' '})|title }}</strong><small class="d-block text-muted">Documento #{{ doc.id_traspaso_documento }} · versión {{ doc.version }} · {{ doc.nombre_original }} · {{ doc.fecha_carga|date('d/m/Y H:i') }}</small><span class="transfer-document-status transfer-document-status--{{ document_status_classes[doc.archivo_estado]|default('unavailable') }}"><i class="fa-solid {{ doc.archivo_disponible ? 'fa-circle-check' : 'fa-triangle-exclamation' }}" aria-hidden="true"></i>{{ document_status_labels[doc.archivo_estado]|default('Estado no disponible') }}</span>{% if transfer_permissions['descargar-documentos'] and doc.archivo_disponible %}<a class="btn btn-sm mt-2" href="{{ get_base_url() }}traspasos/descargar-documento/{{ doc.id_traspaso_documento }}">Descargar</a>{% endif %}{% if not doc.archivo_disponible %}<p class="transfer-file-unavailable" role="status">Archivo no disponible: {{ doc.archivo_mensaje }}</p>{% endif %}</article>{% endif %}{% endfor %}
            {% for doc in traspaso.documentos %}{% if doc.obsoleto and doc.id_bien and not doc.es_evidencia %}<article class="transfer-document-card mb-2"><strong>Versión anterior · {{ doc.tipo_documento|replace({'_':' '})|title }}</strong><small class="d-block text-muted">Documento #{{ doc.id_traspaso_documento }} · versión {{ doc.version }} · {{ doc.bien_label }} · {{ doc.nombre_original }} · {{ doc.fecha_carga|date('d/m/Y H:i') }}</small><span class="transfer-document-status transfer-document-status--{{ document_status_classes[doc.archivo_estado]|default('unavailable') }}"><i class="fa-solid {{ doc.archivo_disponible ? 'fa-circle-check' : 'fa-triangle-exclamation' }}" aria-hidden="true"></i>{{ document_status_labels[doc.archivo_estado]|default('Estado no disponible') }}</span>{% if transfer_permissions['descargar-documentos'] and doc.archivo_disponible %}<a class="btn btn-sm mt-2" href="{{ get_base_url() }}traspasos/descargar-documento/{{ doc.id_traspaso_documento }}">Descargar versión anterior</a>{% endif %}{% if not doc.archivo_disponible %}<p class="transfer-file-unavailable" role="status">Archivo no disponible: {{ doc.archivo_mensaje }}</p>{% endif %}</article>{% endif %}{% endfor %}
          </div></details>{% endif %}

          {% if traspaso.documentos_vigentes %}
            {% for doc in traspaso.documentos_vigentes %}
              {% set documentTitle = doc.tipo_documento == 'TARJETA_RESGUARDO' ? 'Tarjeta de resguardo' : (doc.tipo_documento == 'BAJA_RESGUARDANTE' ? 'Baja de resguardante' : 'Resguardo del equipo') %}
              {% set evidenceStatus = doc.estado_evidencia|default('SIN_EVIDENCIA') %}
              <article class="transfer-document-card transfer-document-card--v2 mb-3" id="documento-{{ doc.id_bien }}-{{ doc.tipo_documento }}">
                <header class="transfer-document-card__header"><div><div class="transfer-document-card__context"><span>Expediente {{ traspaso.folio }}</span><span>Estado patrimonial: {{ traspaso.estado_etiqueta }}</span><span>{{ doc.tipo_documento|replace({'_':' '})|title }}</span></div><h3 class="transfer-document-card__title">{{ documentTitle }}</h3><p class="transfer-document-card__meta">Documento #{{ doc.id_traspaso_documento }} · versión {{ doc.version }}{% if doc.bien_label %} · {{ doc.bien_label }}{% endif %}</p></div><div class="transfer-document-card__states"><span class="transfer-document-status transfer-document-status--{{ document_status_classes[doc.archivo_estado]|default('unavailable') }}"><i class="fa-solid {{ doc.archivo_disponible ? 'fa-circle-check' : 'fa-triangle-exclamation' }}" aria-hidden="true"></i>{{ document_status_labels[doc.archivo_estado]|default('Estado no disponible') }}</span><span class="transfer-evidence-pill transfer-evidence-pill--{{ evidenceStatus|lower }}">{% if evidenceStatus == 'VALIDADO' %}<i class="fa-solid fa-circle-check" aria-hidden="true"></i> Evidencia validada{% elseif evidenceStatus == 'RECHAZADO' %}<i class="fa-solid fa-circle-xmark" aria-hidden="true"></i> Evidencia rechazada{% elseif evidenceStatus == 'PENDIENTE' %}<i class="fa-solid fa-clock" aria-hidden="true"></i> Evidencia pendiente{% else %}<i class="fa-regular fa-file" aria-hidden="true"></i> Sin evidencia{% endif %}</span></div></header>

                <section class="transfer-document-file" aria-label="Documento del expediente"><div class="transfer-file-heading"><span class="transfer-pdf-icon" aria-hidden="true"><i class="fa-solid fa-file-pdf"></i></span><div><strong class="transfer-file-heading__label">{{ doc.origen_archivo == 'GENERADO' ? 'Documento generado' : 'Documento cargado' }}</strong><span class="transfer-file-heading__name" title="{{ doc.nombre_original }}">{{ doc.nombre_original }}</span><small class="d-block text-muted">Actualizado {{ doc.fecha_carga|date('d/m/Y H:i') }}{% if doc.tamano_legible %} · {{ doc.tamano_legible }}{% endif %}</small>{% if not doc.archivo_disponible %}<p class="transfer-file-unavailable" role="status"><strong>Archivo no disponible.</strong> {{ doc.archivo_mensaje }} Esta incidencia técnica no modifica el estado patrimonial ni administrativo del expediente.</p>{% endif %}</div></div>{% if transfer_permissions['descargar-documentos'] and doc.archivo_disponible %}<div class="transfer-document-actions"><a class="btn btn-sm" href="{{ get_base_url() }}traspasos/ver-documento/{{ doc.id_traspaso_documento }}" target="_blank" rel="noopener"><i class="fa-solid fa-print" aria-hidden="true"></i>Ver / Imprimir</a><a class="btn btn-sm" href="{{ get_base_url() }}traspasos/descargar-documento/{{ doc.id_traspaso_documento }}"><i class="fa-solid fa-download" aria-hidden="true"></i>Descargar</a></div>{% endif %}</section>
                {% if doc.tipo_documento == 'TARJETA_RESGUARDO' and doc.puede_editar_tarjeta %}
                  <details class="transfer-card-editor"><summary class="btn btn-sm"><i class="fa-solid fa-pen" aria-hidden="true"></i>Editar observaciones</summary><form method="post" action="{{ get_base_url() }}traspasos/editar-datos-documentos/{{ traspaso.id_traspaso }}" class="row g-2 mt-2" data-preserve-anchor="documento-{{ doc.id_bien }}-{{ doc.tipo_documento }}"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="return_anchor" value="documento-{{ doc.id_bien }}-{{ doc.tipo_documento }}"><input type="hidden" name="documento_tarjeta" value="{{ doc.id_traspaso_documento }}"><p class="small text-muted mb-1">Todos los datos se recuperan del sistema. Sólo las observaciones pueden ajustarse para esta versión documental.</p>
                    <div class="col-12"><label class="form-label small" for="tarjetaObservaciones{{ doc.id_bien }}">0) OBSERVACIONES</label><textarea class="form-control form-control-sm" id="tarjetaObservaciones{{ doc.id_bien }}" name="campos_tarjeta[observaciones]" rows="3" maxlength="1000">{{ doc.tarjeta_campos.observaciones|default('') }}</textarea></div>
                    <div class="col-12"><button class="btn btn-sm" type="submit">Guardar cambios y actualizar PDF</button></div></form></details>
                {% endif %}
                {% if doc.tipo_documento == 'RESGUARDO_EQUIPO' and doc.puede_editar_resguardo_equipo %}
                  <details class="transfer-card-editor"><summary class="btn btn-sm"><i class="fa-solid fa-pen" aria-hidden="true"></i>Editar datos del documento</summary><form method="post" action="{{ get_base_url() }}traspasos/editar-datos-documentos/{{ traspaso.id_traspaso }}" class="row g-2 mt-2" data-preserve-anchor="documento-{{ doc.id_bien }}-{{ doc.tipo_documento }}"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="return_anchor" value="documento-{{ doc.id_bien }}-{{ doc.tipo_documento }}"><input type="hidden" name="documento_resguardo_equipo" value="{{ doc.id_traspaso_documento }}"><p class="small text-muted mb-1">Sólo estos cinco campos pueden ajustarse para esta versión documental. Los demás datos provienen del sistema.</p>
                    <div class="col-12"><label class="form-label small" for="resguardoNotas{{ doc.id_bien }}">Notas (dirección donde se encuentra el bien)</label><textarea class="form-control form-control-sm" id="resguardoNotas{{ doc.id_bien }}" name="campos_resguardo_equipo[notas]" rows="2" maxlength="1000">{{ doc.resguardo_equipo_campos.notas|default('') }}</textarea></div>
                    <div class="col-md-6"><label class="form-label small" for="resguardoTipo{{ doc.id_bien }}">Tipo de equipo</label><input class="form-control form-control-sm" id="resguardoTipo{{ doc.id_bien }}" name="campos_resguardo_equipo[tipo_equipo]" maxlength="150" value="{{ doc.resguardo_equipo_campos.tipo_equipo|default('') }}"></div>
                    {% set estadoEquipoActual = doc.resguardo_equipo_campos.estado_equipo|default('')|trim %}{% set estadoEquipoNormalizado = estadoEquipoActual|lower %}{% set estadoEquipoPredefinido = estadoEquipoNormalizado in ['completo','incompleto'] %}
                    <div class="col-md-6"><label class="form-label small" for="resguardoEstadoOpcion{{ doc.id_bien }}">Estado del equipo</label><select class="form-select form-select-sm" id="resguardoEstadoOpcion{{ doc.id_bien }}" data-equipment-state-select data-custom-target="resguardoEstado{{ doc.id_bien }}"><option value="Completo"{{ estadoEquipoNormalizado == 'completo' ? ' selected' : '' }}>Completo</option><option value="Incompleto"{{ estadoEquipoNormalizado == 'incompleto' ? ' selected' : '' }}>Incompleto</option><option value="__custom__"{{ not estadoEquipoPredefinido ? ' selected' : '' }}>Escribir</option></select><input class="form-control form-control-sm mt-2" id="resguardoEstado{{ doc.id_bien }}" name="campos_resguardo_equipo[estado_equipo]" maxlength="150" value="{{ estadoEquipoActual }}" placeholder="Escriba el estado del equipo" data-equipment-state-custom{{ estadoEquipoPredefinido ? ' type="hidden"' : ' type="text" required' }}></div>
                    <div class="col-12"><label class="form-label small" for="resguardoObservaciones{{ doc.id_bien }}">Observaciones</label><textarea class="form-control form-control-sm" id="resguardoObservaciones{{ doc.id_bien }}" name="campos_resguardo_equipo[observaciones]" rows="3" maxlength="2000">{{ doc.resguardo_equipo_campos.observaciones|default('') }}</textarea></div>
                    <div class="col-md-4"><label class="form-label small" for="resguardoCandado{{ doc.id_bien }}">Candado</label><select class="form-select form-select-sm" id="resguardoCandado{{ doc.id_bien }}" name="campos_resguardo_equipo[candado]" required><option value="SI"{{ doc.resguardo_equipo_campos.candado == 'SI' ? ' selected' : '' }}>Sí</option><option value="NO"{{ doc.resguardo_equipo_campos.candado == 'NO' ? ' selected' : '' }}>No</option></select></div>
                    <div class="col-12"><button class="btn btn-sm" type="submit">Guardar cambios y actualizar PDF</button></div></form></details>
                {% endif %}
                {% if doc.tipo_documento == 'BAJA_RESGUARDANTE' %}<div class="transfer-ccp-editor">
                  {% if doc.puede_editar_baja %}<details><summary class="btn btn-sm"><i class="fa-solid fa-pen" aria-hidden="true"></i>Editar datos</summary><form method="post" action="{{ get_base_url() }}traspasos/editar-datos-documentos/{{ traspaso.id_traspaso }}" class="row g-2 mt-2" data-preserve-anchor="documento-{{ doc.id_bien }}-{{ doc.tipo_documento }}"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="return_anchor" value="documento-{{ doc.id_bien }}-{{ doc.tipo_documento }}"><input type="hidden" name="documento_baja" value="{{ doc.id_traspaso_documento }}"><p class="small text-muted mb-1">Sólo C. c. p. y Observaciones pueden ajustarse. Los demás datos se recuperan automáticamente del expediente.</p><div class="col-12"><label class="form-label small fw-semibold" for="ccpBaja{{ doc.id_bien }}">C. c. p.</label><textarea class="form-control form-control-sm" id="ccpBaja{{ doc.id_bien }}" name="campos_baja[ccp]" rows="2" maxlength="500">{{ doc.baja_campos.ccp|default('') }}</textarea></div><div class="col-12"><label class="form-label small fw-semibold" for="observacionesBaja{{ doc.id_bien }}">Observaciones</label><textarea class="form-control form-control-sm" id="observacionesBaja{{ doc.id_bien }}" name="campos_baja[observaciones]" rows="3" maxlength="2000">{{ doc.baja_campos.observaciones|default('') }}</textarea></div><div class="col-12"><button class="btn btn-sm" type="submit">Guardar y actualizar PDF</button></div></form></details>
                  {% elseif doc.ccp_baja %}<p class="small mb-0"><strong>C. c. p.</strong> {{ doc.ccp_baja }}</p>{% endif %}
                </div>{% endif %}
                <section class="transfer-evidence" aria-label="Evidencia firmada"><div class="transfer-evidence__header"><div><h4>Evidencia firmada</h4>{% if doc.evidencia_archivo %}<p title="{{ doc.evidencia_archivo.nombre_original }}">{{ doc.evidencia_archivo.nombre_original }}</p>{% else %}<p>Sin evidencia cargada</p>{% endif %}</div>{% if doc.evidencia_archivo %}<span class="transfer-evidence-pill transfer-evidence-pill--{{ evidenceStatus|lower }}">{{ evidenceStatus|title }}</span>{% endif %}</div>
                  {% if doc.evidencia_archivo %}<p class="transfer-evidence__meta">Cargada {{ doc.evidencia_archivo.fecha_carga|date('d/m/Y H:i') }}{% if doc.evidencia_archivo.usuario_carga %} · {{ doc.evidencia_archivo.usuario_carga }}{% endif %}{% if doc.evidencia_archivo.tamano_legible %} · {{ doc.evidencia_archivo.tamano_legible }}{% endif %}</p>{% if not doc.evidencia_archivo.archivo_disponible %}<p class="transfer-file-unavailable" role="status"><strong>Evidencia no disponible.</strong> {{ doc.evidencia_archivo.archivo_mensaje }} Esta incidencia técnica no modifica el estado patrimonial ni administrativo del expediente.</p>{% endif %}{% if evidenceStatus == 'VALIDADO' and doc.validacion_evidencia %}<p class="transfer-evidence__review transfer-evidence__review--valid">Validado por {{ doc.validacion_evidencia.username|default('administrador') }} · {{ doc.validacion_evidencia.fecha_evento|date('d/m/Y H:i') }}</p>{% elseif evidenceStatus == 'RECHAZADO' and doc.rechazo_evidencia %}<p class="transfer-evidence__review transfer-evidence__review--rejected">Motivo de rechazo: {{ doc.rechazo_evidencia.motivo }}</p>{% endif %}{% else %}<p class="transfer-evidence__meta">Imprime el PDF, recaba las firmas manuscritas y carga el archivo digitalizado.</p>{% endif %}
                  <div class="transfer-document-actions">{% if doc.evidencia_archivo and doc.evidencia_archivo.archivo_disponible and transfer_permissions['descargar-documentos'] %}<a class="btn btn-sm" href="{{ get_base_url() }}traspasos/ver-documento/{{ doc.evidencia_archivo.id_traspaso_documento }}" target="_blank" rel="noopener"><i class="fa-regular fa-eye" aria-hidden="true"></i>Ver evidencia</a><a class="btn btn-sm" href="{{ get_base_url() }}traspasos/descargar-documento/{{ doc.evidencia_archivo.id_traspaso_documento }}"><i class="fa-solid fa-download" aria-hidden="true"></i>Descargar evidencia</a>{% endif %}
                    {% if doc.evidencia_archivo and doc.evidencia_archivo.archivo_disponible and doc.archivo_disponible and evidenceStatus == 'PENDIENTE' and is_transfer_admin and transfer_permissions.autorizar %}<form method="post" action="{{ get_base_url() }}traspasos/validar-evidencia/{{ traspaso.id_traspaso }}"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="return_anchor" value="documento-{{ doc.id_bien }}-{{ doc.tipo_documento }}"><input type="hidden" name="documento_origen" value="{{ doc.id_traspaso_documento }}"><input type="hidden" name="documento_evidencia" value="{{ doc.evidencia_archivo.id_traspaso_documento }}"><button class="btn btn-sm" type="submit"><i class="fa-solid fa-check" aria-hidden="true"></i>Validar evidencia</button></form>{% endif %}</div>
                  {% if doc.evidencia_archivo and evidenceStatus == 'PENDIENTE' and is_transfer_admin and transfer_permissions.rechazar %}<details class="transfer-reject-control"><summary class="btn btn-sm"><i class="fa-solid fa-xmark" aria-hidden="true"></i>Rechazar</summary><form method="post" action="{{ get_base_url() }}traspasos/rechazar-evidencia/{{ traspaso.id_traspaso }}" class="mt-2" data-preserve-anchor="documento-{{ doc.id_bien }}-{{ doc.tipo_documento }}"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="return_anchor" value="documento-{{ doc.id_bien }}-{{ doc.tipo_documento }}"><input type="hidden" name="documento_origen" value="{{ doc.id_traspaso_documento }}"><input type="hidden" name="documento_evidencia" value="{{ doc.evidencia_archivo.id_traspaso_documento }}"><label class="visually-hidden" for="evidenceRejection{{ doc.id_traspaso_documento }}">Motivo de rechazo</label><textarea class="form-control form-control-sm" id="evidenceRejection{{ doc.id_traspaso_documento }}" name="motivo_rechazo" rows="2" maxlength="500" required placeholder="Motivo de rechazo"></textarea><button class="btn btn-sm mt-2" type="submit">Confirmar rechazo</button></form></details>{% endif %}
                  {% if traspaso.estado == 'VALIDADO' and transfer_permissions['subir-documento'] %}<form id="evidenceForm{{ doc.id_traspaso_documento }}" method="post" enctype="multipart/form-data" action="{{ get_base_url() }}traspasos/subir-documento-firmado/{{ traspaso.id_traspaso }}" class="transfer-evidence-upload" data-preserve-anchor="documento-{{ doc.id_bien }}-{{ doc.tipo_documento }}"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="documento_origen" value="{{ doc.id_traspaso_documento }}"><input type="hidden" name="return_anchor" value="documento-{{ doc.id_bien }}-{{ doc.tipo_documento }}"><input class="form-control form-control-sm" id="signedDocument{{ doc.id_traspaso_documento }}" type="file" name="documento_firmado" accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png" required {% if doc.evidencia_archivo %}hidden{% endif %}>{% if doc.evidencia_archivo %}<button class="btn btn-sm" type="button" data-evidence-trigger="signedDocument{{ doc.id_traspaso_documento }}"><i class="fa-solid fa-upload" aria-hidden="true"></i>Subir / Reemplazar</button>{% else %}<button class="btn btn-sm" type="submit"><i class="fa-solid fa-upload" aria-hidden="true"></i>Subir evidencia</button>{% endif %}</form>{% endif %}
                  {% if doc.evidencias_anteriores %}<details class="transfer-evidence-history"><summary>Historial ({{ doc.evidencias_anteriores|length }})</summary>{% for oldEvidence in doc.evidencias_anteriores %}<div class="transfer-evidence-history__item"><div><strong title="{{ oldEvidence.nombre_original }}">{{ oldEvidence.nombre_original }}</strong><small>{{ oldEvidence.fecha_carga|date('d/m/Y H:i') }}{% if oldEvidence.usuario_carga %} · {{ oldEvidence.usuario_carga }}{% endif %}</small>{% if not oldEvidence.archivo_disponible %}<span class="transfer-file-unavailable">Archivo no disponible: {{ oldEvidence.archivo_mensaje }}</span>{% endif %}</div><span class="transfer-evidence-pill transfer-evidence-pill--{{ oldEvidence.estado_evidencia|default('pendiente')|lower }}">{{ oldEvidence.estado_evidencia|default('PENDIENTE')|title }}</span>{% if transfer_permissions['descargar-documentos'] and oldEvidence.archivo_disponible %}<div class="transfer-evidence-history__actions"><a href="{{ get_base_url() }}traspasos/ver-documento/{{ oldEvidence.id_traspaso_documento }}" target="_blank" rel="noopener">Ver evidencia</a><a href="{{ get_base_url() }}traspasos/descargar-documento/{{ oldEvidence.id_traspaso_documento }}">Descargar</a></div>{% endif %}</div>{% endfor %}</details>{% endif %}
                </section>
              </article>
            {% endfor %}
          {% else %}<p class="text-muted">Aún no se han generado los documentos obligatorios.</p>{% endif %}

          {% if traspaso.evidencias_historicas %}<details class="mt-3"><summary class="fw-semibold">Evidencias de versiones anteriores</summary>{% for oldEvidence in traspaso.evidencias_historicas %}<div class="small mt-2">{{ oldEvidence.nombre_original }} · {{ oldEvidence.tamano_legible }} · {{ oldEvidence.fecha_carga|date('d/m/Y H:i') }}{% if transfer_permissions['descargar-documentos'] and oldEvidence.archivo_disponible %} · <a href="{{ get_base_url() }}traspasos/ver-documento/{{ oldEvidence.id_traspaso_documento }}" target="_blank" rel="noopener">Ver</a> · <a href="{{ get_base_url() }}traspasos/descargar-documento/{{ oldEvidence.id_traspaso_documento }}">Descargar</a>{% endif %}{% if not oldEvidence.archivo_disponible %} · <span class="transfer-file-unavailable">Archivo no disponible: {{ oldEvidence.archivo_mensaje }}</span>{% endif %}</div>{% endfor %}</details>{% endif %}

          {% if traspaso.estado == 'VALIDADO' and transfer_permissions['generar-tarjeta'] and transfer_permissions['generar-resguardo'] %}
            <form method="post" action="{{ get_base_url() }}traspasos/generar-documentos/{{ traspaso.id_traspaso }}" class="transfer-generate-form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="return_anchor" value="documentos-expediente"><div class="d-flex flex-wrap justify-content-between align-items-center gap-2"><div><h3 class="h6 mb-1">Documentos del expediente</h3><p class="small text-muted mb-0">La baja documental se genera únicamente cuando existe un resguardante anterior. La baja no modifica el estado de los bienes.</p></div><button class="btn btn-sm" type="submit" title="Actualiza los documentos del expediente con las fechas y datos actuales. No modifica el estado de los bienes." aria-label="Actualizar documentos"><i class="fa-solid fa-arrows-rotate me-1" aria-hidden="true"></i>Actualizar documentos</button></div>
            </form>
          {% endif %}

          {% if traspaso.estado == 'VALIDADO' and transfer_permissions.ejecutar and traspaso.listo_para_completar %}<form method="post" action="{{ get_base_url() }}traspasos/completar/{{ traspaso.id_traspaso }}" class="mt-3" onsubmit="return confirm('¿Confirmas completar el traspaso? Se actualizarán la unidad, ubicación y resguardo de todos los bienes y se registrarán sus movimientos.');"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="return_anchor" value="documentos-expediente"><button class="btn" type="submit"><i class="fa-solid fa-check-double me-1" aria-hidden="true"></i>Completar traspaso</button></form>{% elseif traspaso.estado == 'VALIDADO' and transfer_permissions.ejecutar %}<p class="small text-muted mt-3 mb-0">Para completar, cada documento requerido debe tener evidencia vigente validada por un administrador.</p>{% endif %}

        </div>
      </section>

    </div>

    <div class="col-12">
      {% if traspaso.estado == 'COMPLETADO' and is_transfer_admin and transfer_permissions['crear'] %}<section class="card border-0 shadow-sm mb-4"><div class="card-header bg-white"><h2 class="h5 mb-0">Reversión</h2></div><div class="card-body"><form method="post" action="{{ get_base_url() }}traspasos/revertir/{{ traspaso.id_traspaso }}" class="vstack gap-2"><input type="hidden" name="csrf" value="{{ csrf }}"><label class="form-label" for="reverseReason">Motivo de reversión</label><textarea class="form-control" id="reverseReason" name="motivo" required maxlength="500"></textarea><button class="btn" type="submit">Crear expediente compensatorio</button></form></div></section>{% endif %}

      <section class="card border-0 shadow-sm mb-4" aria-labelledby="transferHistoryTitle">
        <div class="card-header bg-white"><h2 id="transferHistoryTitle" class="h5 mb-0">{{ traspaso.tipo == 'ENTRE_UNIDADES' ? '4' : '3' }}. Historial del expediente</h2></div>
        <div class="transfer-timeline" data-transfer-timeline>{% for event in traspaso.eventos %}<article class="transfer-timeline__event" {% if traspaso.eventos|length > 2 and loop.index <= traspaso.eventos|length - 2 %}hidden data-history-extra{% endif %}><span class="transfer-timeline__marker" aria-hidden="true"></span><div><div class="d-flex justify-content-between flex-wrap gap-2"><strong>{{ event.tipo_evento|replace({'_':' '})|title }}</strong><time class="text-muted" datetime="{{ event.fecha_evento|date('c') }}">{{ event.fecha_evento|date('d/m/Y H:i') }}</time></div><div>Usuario: {{ event.username|default('Usuario no disponible') }}{% if event.estado_anterior or event.estado_nuevo %} · {{ event.estado_anterior|default('—') }} → {{ event.estado_nuevo|default('—') }}{% endif %}</div>{% if event.motivo %}<small class="text-muted">{{ event.motivo }}</small>{% endif %}{% if event.metadatos.tipo|default(null) %}<small class="d-block text-muted">Documento: {{ event.metadatos.tipo|replace({'_':' '})|title }}{% if event.metadatos.version|default(null) %} · versión {{ event.metadatos.version }}{% endif %}</small>{% endif %}</div></article>{% else %}<p class="text-muted">Sin eventos.</p>{% endfor %}</div>{% if traspaso.eventos|length > 2 %}<button class="btn btn-sm mt-3" type="button" data-history-toggle aria-expanded="false">Mostrar historial completo</button>{% endif %}
      </section>

    </div>
  </div>
</div>
<script src="{{ get_base_url() }}assets/js/traspasos-detalle.js?v={{ get_asset_version() }}"></script>
{% include 'includes/admin/inventory-bottom.twig' %}
