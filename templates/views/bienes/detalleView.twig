{% include 'includes/admin/inventory-top.twig' %}
<div class="d-sm-flex align-items-center justify-content-between mb-4"><div><h1 class="h3 mb-1 bi-title">{{ bien.nombre_bien }}</h1><p class="text-muted mb-0">{{ bien.numero_inventario }} · {{ bien.numero_serie|default('Sin serie') }}</p></div><div><a class="btn btn-outline-secondary" href="{{ get_base_url() }}bienes">Inventario</a><a class="btn bi-btn-primary" href="{{ get_base_url() }}bienes/editar/{{ bien.id_bien }}">Editar</a></div></div>
<div class="row"><div class="col-lg-8"><div class="card shadow-sm border-0 mb-4"><div class="card-header bg-white"><strong>Identificación y clasificación</strong></div><div class="card-body bi-detail-grid"><div><small>CI</small><strong>{{ bien.numero_inventario }}</strong></div><div><small>NIC / CEA</small><strong>{{ bien.nic_cea|default('—') }}</strong></div><div><small>Activo genérico</small><strong>{{ bien.activo_generico_nombre|default('—') }}</strong></div><div><small>Grupo / específico</small><strong>{{ bien.grupo_nombre|default('—') }} · {{ bien.activo_especifico_nombre|default('—') }}</strong></div><div><small>Marca / modelo</small><strong>{{ bien.marca_nombre|default('—') }} {{ bien.modelo_nombre ? '· ' ~ bien.modelo_nombre : '' }}</strong></div><div><small>Estado de uso</small><strong>{{ bien.estado_nombre|default('—') }}</strong></div></div></div><div class="card shadow-sm border-0 mb-4"><div class="card-header bg-white"><strong>Información física y administrativa</strong></div><div class="card-body bi-detail-grid"><div><small>Serie</small><strong>{{ bien.numero_serie|default('—') }}</strong></div><div><small>Material / color</small><strong>{{ bien.material|default('—') }} / {{ bien.color|default('—') }}</strong></div><div><small>Unidad administrativa</small><strong>{{ bien.codigo_ua }} · {{ bien.unidad_nombre }}</strong></div><div><small>Ubicación</small><strong>{{ bien.ubicacion_fisica|default('—') }}</strong></div><div><small>Valor</small><strong>{{ bien.valor ? '$' ~ bien.valor : '—' }}</strong></div><div><small>Resguardante</small><strong>{{ bien.resguardante_nombre|default('Pendiente') }}</strong></div></div><div class="card-body pt-0"><small>Características</small><p class="mb-0">{{ bien.caracteristicas|default('Sin especificar') }}</p></div></div></div><div class="col-lg-4"><div class="card shadow-sm border-0 mb-4"><div class="card-header bg-white"><strong>Acciones</strong></div><div class="card-body d-grid gap-2"><a class="btn btn-outline-secondary" href="{{ get_base_url() }}resguardos/tarjeta/{{ bien.id_bien }}">Tarjeta de resguardo</a><a class="btn btn-outline-secondary" href="{{ get_base_url() }}resguardos/resguardo_equipo/{{ bien.id_bien }}">Resguardo del equipo</a><a class="btn btn-outline-secondary" href="{{ get_base_url() }}resguardos/baja_resguardante/{{ bien.id_bien }}">Baja de resguardante</a></div></div><div class="card shadow-sm border-0"><div class="card-header bg-white"><strong>Componentes</strong></div><ul class="list-group list-group-flush">{% for componente in bien.componentes %}<li class="list-group-item"><strong>{{ componente.tipo_componente }}</strong><br><small>{{ componente.marca|default('') }} {{ componente.modelo|default('') }} · {{ componente.numero_serie|default('Sin serie') }}</small></li>{% else %}<li class="list-group-item text-muted">Sin componentes registrados.</li>{% endfor %}</ul></div></div></div>
<div class="card shadow-sm border-0"><div class="card-header bg-white"><strong>Trazabilidad</strong></div><div class="card-body"><ul class="bi-timeline">{% for movimiento in bien.movimientos %}<li><strong>{{ movimiento.tipo_movimiento }}</strong><span>{{ movimiento.fecha_movimiento|date('d/m/Y H:i') }}</span><p>{{ movimiento.motivo|default(movimiento.observaciones|default('')) }}</p></li>{% else %}<li>Sin movimientos registrados.</li>{% endfor %}</ul></div></div>
{% include 'includes/admin/inventory-bottom.twig' %}
