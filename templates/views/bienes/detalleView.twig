{% include 'includes/admin/inventory-top.twig' %}
<div class="d-sm-flex align-items-center justify-content-between mb-4">
  <div><h1 class="h3 mb-1 bi-title">{{ bien.nombre_bien|title }}</h1><p class="text-muted mb-0">{{ bien.clave_interna|default('Sin CI') }} · {{ bien.numero_serie|default('Sin Serie') }}</p></div>
</div>

<div class="row">
  <div class="col-lg-10">
    <div class="card shadow-sm border-0 mb-4"><div class="card-header bg-white"><strong>Identificación y clasificación</strong></div><div class="card-body bi-detail-grid">
      <div><small>Clave interna CI</small><strong>{{ bien.clave_interna|default('—') }}</strong></div>
      <div><small>Número de inventario</small><strong>{{ bien.numero_inventario|default('—') }}</strong></div>
      <div><small>NIC / CEA</small><strong>{{ bien.nic_cea|default('—') }}</strong></div>
      <div><small>Activo genérico</small><strong>{{ bien.activo_generico_nombre|default('—') }}</strong></div>
      <div><small>Grupo del activo</small><strong>{{ bien.grupo_nombre|default('—') }}</strong></div>
      <div><small>Activo específico</small><strong>{{ bien.activo_especifico_nombre|default('—') }}</strong></div>
      <div><small>Nombre del bien</small><strong>{{ bien.nombre_bien|default('—') }}</strong></div>
    </div></div>

    <div class="card shadow-sm border-0 mb-4"><div class="card-header bg-white"><strong>Características</strong></div><div class="card-body bi-detail-grid">
      <div><small>Material</small><strong>{{ bien.material|default('—') }}</strong></div>
      <div><small>Marca</small><strong>{{ bien.marca_nombre|default('—')|upper }}</strong></div>
      <div><small>Modelo</small><strong>{{ bien.modelo_nombre|default('—') }}</strong></div>
      <div><small>Color</small><strong>{{ bien.color|default('—') }}</strong></div>
      <div><small>Estado de uso</small><strong>{{ bien.estado_nombre|default('—') }}</strong></div>
      <div><small>Serie</small><strong>{{ bien.numero_serie|default('—') }}</strong></div>
      <div><small>Fecha de alta</small><strong>{{ bien.fecha_alta ? bien.fecha_alta|date('d/m/Y') : '—' }}</strong></div>
      <div><small>Fecha de adquisición</small><strong>{{ bien.fecha_adquisicion ? bien.fecha_adquisicion|date('d/m/Y') : '—' }}</strong></div>
      <div><small>Fecha de elaboración</small><strong>{{ bien.fecha_elaboracion ? bien.fecha_elaboracion|date('d/m/Y') : '—' }}</strong></div>
      <div><small>Fecha de asignación</small><strong>{{ bien.fecha_asignacion_actual ? bien.fecha_asignacion_actual|date('d/m/Y') : (bien.fecha_asignacion ? bien.fecha_asignacion|date('d/m/Y') : '—') }}</strong></div>
      <div><small>Valor</small><strong>{% if bien.valor is not null and bien.valor != '' %}${{ bien.valor|number_format(2, '.', ',') }} MXN{% else %}—{% endif %}</strong></div>
      <div><small>Resguardante</small>{% if bien.resguardante_nombre %}<strong class="d-block">{{ bien.resguardante_csp|default('CSP no capturado') }}</strong><small>{{ bien.resguardante_nombre|title }}</small>{% else %}<strong>Sin Asignar</strong>{% endif %}</div>
    </div><div class="card-body border-top"><small>Características</small><p class="mb-3">{{ bien.caracteristicas|default('S/C', true) }}</p><small>Observaciones</small><p class="mb-0">{{ bien.observaciones|default('—', true) }}</p></div></div>

    <div class="card shadow-sm border-0 mb-4"><div class="card-header bg-white"><strong>Administración y ubicación</strong></div><div class="card-body bi-detail-grid">
      {% for etiqueta, valor in {'Secretaría': bien.jerarquia_administrativa.secretaria, 'Subsecretaría': bien.jerarquia_administrativa.subsecretaria, 'Dirección': bien.jerarquia_administrativa.direccion_secretaria, 'Dirección de Área': bien.jerarquia_administrativa.direccion_area, 'Delegación Administrativa': bien.jerarquia_administrativa.delegacion_administrativa, 'Subdirección': bien.jerarquia_administrativa.subdireccion, 'Departamento': bien.jerarquia_administrativa.departamento, 'Oficina': bien.jerarquia_administrativa.oficina} %}
        <div><small>{{ etiqueta }}</small><strong>{{ valor|default(' ', true) }}</strong></div>
      {% endfor %}
      <div><small>Código De Unidad Administrativa</small><strong>{{ bien.codigo_ua|default('Sin código UA') }}</strong></div>
      <div><small>Municipio</small><strong>{{ bien.municipio|default('—') }}</strong></div>
      <div><small>Localidad</small><strong>{{ bien.localidad|default('—') }}</strong></div>
    </div><div class="card-body border-top"><h2 class="h6 mb-3">Ubicación física del bien</h2><div class="bi-detail-grid"><div><small>PISO</small><strong>{{ bien.piso|default('—') }}</strong></div><div><small>SECCIÓN/ALA</small><strong>{{ bien.seccion_ala|default('—') }}</strong></div><div><small>CUBÍCULO</small><strong>{{ bien.cubiculo|default('—') }}</strong></div></div></div></div>
  </div>
  <aside class="col-lg-2"><div class="card shadow-sm border-0 mb-4 bi-detail-actions"><div class="card-header bg-white"><strong>Acciones</strong></div><div class="card-body d-grid gap-2">
    <a class="btn btn-sm btn-outline-secondary w-100" href="{{ get_base_url() }}bienes" title="Regresar" aria-label="Regresar"><i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>Regresar</a>
    <a class="btn btn-sm bi-btn-primary w-100" href="{{ get_base_url() }}bienes/editar/{{ bien.id_bien }}" title="Editar" aria-label="Editar"><i class="fa-solid fa-pen-to-square me-1" aria-hidden="true"></i>Editar</a>
    {% if codigo_barra.codigo %}<button class="btn btn-sm btn-outline-secondary w-100" type="button" data-bs-toggle="modal" data-bs-target="#codigoBarrasModal" title="Mostrar Código De Barras" aria-label="Mostrar Código De Barras"><i class="fa-solid fa-barcode me-1" aria-hidden="true"></i>Código De Barras</button>
    {% endif %}
    <a class="btn btn-sm btn-outline-secondary w-100" href="{{ get_base_url() }}resguardos/tarjeta/{{ bien.id_bien }}" title="Tarjeta De Resguardo" aria-label="Tarjeta De Resguardo"><i class="fa-solid fa-id-card me-1" aria-hidden="true"></i>Tarjeta De Resguardo</a>
    <a class="btn btn-sm btn-outline-secondary w-100" href="{{ get_base_url() }}resguardos/resguardo_equipo/{{ bien.id_bien }}" title="Resguardo Del Equipo" aria-label="Resguardo Del Equipo"><i class="fa-solid fa-file-signature me-1" aria-hidden="true"></i>Resguardo Del Equipo</a>
    <a class="btn btn-sm btn-outline-secondary w-100" href="{{ get_base_url() }}resguardos/baja_resguardante/{{ bien.id_bien }}" title="Baja De Resguardante" aria-label="Baja De Resguardante"><i class="fa-solid fa-file-circle-minus me-1" aria-hidden="true"></i>Baja De Resguardante</a>
</div></div></aside>
</div>

<div class="modal fade" id="codigoBarrasModal" tabindex="-1" aria-labelledby="codigoBarrasTitulo" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content barcode-print-area"><div class="modal-header no-print"><h2 class="modal-title fs-5" id="codigoBarrasTitulo">Código De Barras</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div><div class="modal-body text-center p-4"><p class="mb-1 fw-semibold">{{ bien.nombre_bien|title }}</p><svg data-code128="{{ codigo_barra.codigo }}" role="img" aria-label="Código de barras {{ codigo_barra.codigo }}" viewBox="0 0 640 130" class="barcode-svg"></svg><strong class="d-block mt-2 barcode-value">{{ codigo_barra.codigo }}</strong><small class="text-muted">{{ codigo_barra.tipo_codigo }} · Inventario SICOPA: {{ bien.numero_inventario|default('—') }}</small></div><div class="modal-footer no-print"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal" title="Cancelar" aria-label="Cancelar"><i class="fa-solid fa-xmark" aria-hidden="true"></i><span class="visually-hidden">Cancelar</span></button></div></div></div></div>

<div class="card shadow-sm border-0 mb-4"><div class="card-header bg-white"><strong>Componentes</strong></div><div class="table-responsive"><table class="table table-striped mb-0 bi-components-table"><thead class="table-light"><tr><th>Componente</th><th>Marca</th><th>Modelo</th><th>Serie</th><th>Inventario / CI</th></tr></thead><tbody>{% for componente in bien.componentes %}<tr><td>{{ componente.tipo_componente }}</td><td>{{ componente.marca|default('N/A', true)|upper }}</td><td>{{ componente.modelo|default('N/A', true) }}</td><td>{{ componente.numero_serie|default('N/A', true) }}</td><td>{{ componente.numero_inventario|default('N/A', true) }}</td></tr>{% endfor %}</tbody></table></div></div>
<div class="card shadow-sm border-0" id="trazabilidad"><div class="card-header bg-white d-flex justify-content-between align-items-center"><strong>Trazabilidad</strong><a class="small" href="{{ get_base_url() }}historico-movimientos?q={{ bien.clave_interna|url_encode }}">Ver histórico completo</a></div><div class="card-body"><ul class="bi-timeline">{% for movimiento in bien.movimientos %}<li><strong>{{ movimiento.tipo_movimiento }}</strong><span>{{ movimiento.fecha_movimiento|date('d/m/Y H:i') }}</span><p>{{ movimiento.motivo|default(movimiento.observaciones|default('')) }} <a class="small" href="{{ get_base_url() }}historico-movimientos/detalle/{{ movimiento.id_movimiento }}">Ver qué cambió</a></p></li>{% else %}<li>Sin movimientos registrados.</li>{% endfor %}</ul></div></div>
{% include 'includes/admin/inventory-bottom.twig' %}
