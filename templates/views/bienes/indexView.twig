{% include 'includes/admin/inventory-top.twig' %}
<div class="d-sm-flex align-items-center justify-content-between mb-4"><div><h1 class="h3 mb-1 bi-title">Inventario</h1><p class="text-muted mb-0">Consulta y administra los bienes registrados.</p></div><a href="{{ get_base_url() }}bienes/registrar" class="btn bi-btn-primary" title="Registrar Bien" aria-label="Registrar Bien"><i class="fa-solid fa-plus" aria-hidden="true"></i><span class="visually-hidden">Registrar Bien</span></a></div>
<form class="card shadow-sm border-0 mb-4" method="get" id="inventarioFiltros" action="{{ get_base_url() }}bienes/"><div class="card-body"><div class="row g-2"><div class="col-lg-9"><label class="visually-hidden" for="inventarioBusqueda">Buscar Bien</label><input class="form-control" id="inventarioBusqueda" name="q" value="{{ filtros.q|default('') }}" placeholder="Buscar CI, SICOPA, serie, nombre o unidad administrativa" autocomplete="off"></div><div class="col-md-3"><label class="visually-hidden" for="inventarioEstado">Estado Del Bien</label><select id="inventarioEstado" name="activo" class="form-select" aria-label="Estado Del Bien"><option value="">Todos Los Estados</option><option value="1" {{ filtros.activo|default('') == '1' ? 'selected' : '' }}>Activo</option><option value="0" {{ filtros.activo|default('') == '0' ? 'selected' : '' }}>Inactivo</option></select></div></div></div></form>
<div class="card shadow-sm border-0"><div class="table-responsive"><table class="table table-hover mb-0 bi-inventory-table"><thead><tr><th>Clave Interna</th><th>Inventario SICOPA</th><th>Nombre Del Bien</th><th>Marca / Modelo</th><th>Serie</th><th>Resguardante</th><th>Unidad Administrativa</th><th>Estatus</th><th>Acciones</th></tr></thead><tbody id="inventarioResultados">{% include 'views/bienes/_inventory-rows.twig' %}</tbody></table></div></div>
<div class="modal fade" id="codigoBarrasListadoModal" tabindex="-1" aria-labelledby="codigoBarrasListadoTitulo" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content list-barcode-print-area"><div class="modal-header no-print"><h2 class="modal-title fs-5" id="codigoBarrasListadoTitulo">Código De Barras</h2></div><div class="modal-body text-center p-4"><svg data-list-code128 role="img" aria-label="Código de barras del bien seleccionado" viewBox="0 0 640 130" class="barcode-svg"></svg><strong class="d-block mt-2 barcode-value" data-list-barcode-value></strong><small class="text-muted" data-list-inventory></small></div><div class="modal-footer no-print"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal" title="Cancelar" aria-label="Cancelar"><i class="fa-solid fa-xmark me-1" aria-hidden="true"></i>Cancelar</button><button class="btn bi-btn-primary" type="button" data-print-barcode title="Imprimir" aria-label="Imprimir"><i class="fa-solid fa-print me-1" aria-hidden="true"></i>Imprimir</button></div></div></div></div>
{% include 'includes/admin/inventory-bottom.twig' %}
