{% include 'includes/admin/inventory-top.twig' %}
<div class="d-sm-flex align-items-center justify-content-between mb-4"><div><h1 class="h3 mb-1 bi-title">Inventario</h1><p class="text-muted mb-0">Consulta, filtra y administra los bienes registrados.</p></div><div><a href="{{ get_base_url() }}reportes/exportar_pdf" class="btn btn-outline-secondary me-2"><i class="fa-solid fa-file-pdf"></i> Exportar PDF</a><a href="{{ get_base_url() }}bienes/registrar" class="btn bi-btn-primary"><i class="fa-solid fa-plus"></i> Registrar bien</a></div></div>
<form class="card shadow-sm border-0 mb-4" method="get" id="inventarioFiltros"><div class="card-body"><div class="row g-2"><div class="col-lg-5"><label class="visually-hidden">Búsqueda</label><input class="form-control" id="inventarioBusqueda" name="q" value="{{ filtros.q|default('') }}" placeholder="SICOPA, CI, nombre, serie, resguardante o UA"></div><div class="col-md-2"><select name="estado" class="form-select"><option value="">Estado de uso</option>{% for estado in estados %}<option value="{{ estado.id_estado_uso }}" {% if filtros.estado|default('') == estado.id_estado_uso %}selected{% endif %}>{{ estado.nombre }}</option>{% endfor %}</select></div><div class="col-md-2"><select name="marca" class="form-select"><option value="">Marca</option>{% for marca in marcas %}<option value="{{ marca.id_marca }}" {% if filtros.marca|default('') == marca.id_marca %}selected{% endif %}>{{ marca.nombre }}</option>{% endfor %}</select></div><div class="col-md-2"><select name="activo" class="form-select"><option value="">Activo/inactivo</option><option value="1">Activo</option><option value="0">Inactivo</option></select></div><div class="col-md-1"><button class="btn bi-btn-primary w-100" title="Buscar"><i class="fa-solid fa-magnifying-glass"></i></button></div></div></div></form>
<div class="card shadow-sm border-0"><div class="table-responsive"><table class="table table-hover mb-0 bi-inventory-table"><thead><tr><th>Código</th><th>Inventario SICOPA</th><th>CI</th><th>Nombre</th><th>Marca / modelo</th><th>Serie</th><th>Unidad</th><th>Estatus</th><th></th></tr></thead><tbody>{% for bien in bienes %}<tr data-bien-row data-busqueda="{{ bien.numero_inventario }} {{ bien.clave_interna }} {{ bien.nombre_bien }} {{ bien.numero_serie }} {{ bien.resguardante_nombre }} {{ bien.codigo_ua }} {{ bien.unidad_nombre }} {{ bien.estado_nombre }} {{ bien.marca_nombre }} {{ bien.activo_generico_nombre }} {{ bien.grupo_nombre }}" data-estado="{{ bien.id_estado_uso }}" data-marca="{{ bien.id_marca }}" data-activo="{{ bien.activo }}"><td><i class="fa-solid fa-barcode" title="{{ bien.codigo_barra }}"></i></td><td>{{ bien.numero_inventario|default('—') }}</td><td><strong>{{ bien.clave_interna|default('—') }}</strong></td><td>{{ bien.nombre_bien }}</td><td>{{ bien.marca_nombre|default('—') }} {{ bien.modelo_nombre ? '· ' ~ bien.modelo_nombre : '' }}</td><td>{{ bien.numero_serie|default('—') }}</td><td><small>{{ bien.codigo_ua }}<br>{{ bien.unidad_nombre }}</small></td><td><span class="badge {{ bien.activo ? 'text-bg-success' : 'text-bg-secondary' }}">{{ bien.activo ? 'Activo' : 'Inactivo' }}</span></td><td class="text-nowrap"><a href="{{ get_base_url() }}bienes/detalle/{{ bien.id_bien }}" class="btn btn-sm btn-outline-secondary">Ver</a><a href="{{ get_base_url() }}bienes/editar/{{ bien.id_bien }}" class="btn btn-sm btn-outline-secondary">Editar</a></td></tr>{% else %}<tr><td colspan="9" class="text-center py-5 text-muted">No se encontraron bienes.</td></tr>{% endfor %}</tbody></table></div></div>
{% include 'includes/admin/inventory-bottom.twig' %}
