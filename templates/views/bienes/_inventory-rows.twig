{% for bien in bienes %}<tr>
  <td><strong class="font-monospace">{{ bien.clave_interna|default('—') }}</strong></td>
  <td>{{ bien.numero_inventario|default('—') }}</td><td>{{ bien.nombre_bien|title }}</td>
  <td>{% if bien.marca_nombre %}<strong class="d-block">{{ bien.marca_nombre|upper }}</strong><small>{{ bien.modelo_nombre|default('') }}</small>{% else %}—{% endif %}</td>
  <td>{{ bien.numero_serie|default('—') }}</td><td>{% if bien.resguardante_nombre %}<strong class="d-block">{{ bien.resguardante_csp|default('CSP No Capturado') }}</strong><small>{{ bien.resguardante_nombre|title }}</small>{% else %}Sin Asignar{% endif %}</td>
  <td><strong class="d-block">{{ bien.codigo_ua|default('Sin código UA') }}</strong><small>{{ bien.unidad_nombre|title }}</small></td><td><span class="badge {{ bien.activo ? 'text-bg-success' : 'text-bg-secondary' }}">{{ bien.activo ? 'Activo' : 'Inactivo' }}</span></td>
  <td class="text-nowrap"><button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#codigoBarrasListadoModal" data-barcode-code="{{ bien.codigo_barra|default(bien.clave_interna|default('')) }}" data-barcode-inventory="{{ bien.numero_inventario|default('') }}" title="Código De Barras" aria-label="Código De Barras"><i class="fa-solid fa-barcode" aria-hidden="true"></i><span class="visually-hidden">Código De Barras</span></button> <a href="{{ get_base_url() }}bienes/detalle/{{ bien.id_bien }}" class="btn btn-sm btn-outline-secondary" title="Ver Detalle" aria-label="Ver Detalle"><i class="fa-solid fa-eye" aria-hidden="true"></i><span class="visually-hidden">Ver Detalle</span></a> <a href="{{ get_base_url() }}bienes/editar/{{ bien.id_bien }}" class="btn btn-sm btn-outline-secondary" title="Editar" aria-label="Editar"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i><span class="visually-hidden">Editar</span></a> {% if bien.activo %}<a href="{{ get_base_url() }}bienes/cambiar_estado/{{ bien.id_bien }}?_t={{ csrf }}" onclick="return confirm('¿Deseas desactivar este bien?')" class="btn btn-sm btn-outline-danger" title="Desactivar" aria-label="Desactivar"><i class="fa-solid fa-toggle-off" aria-hidden="true"></i><span class="visually-hidden">Desactivar</span></a>{% endif %}</td>
</tr>{% else %}<tr><td colspan="9" class="text-center py-5 text-muted">No se encontraron bienes.</td></tr>{% endfor %}
