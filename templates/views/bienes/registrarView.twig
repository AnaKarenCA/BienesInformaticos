{% include 'includes/admin/inventory-top.twig' %}
<div class="d-sm-flex align-items-center justify-content-between mb-4">
  <div><h1 class="h3 mb-1 bi-title">{{ bien.id_bien ? 'Editar bien' : 'Registrar bien' }}</h1><p class="text-muted mb-0">Los campos con asterisco son obligatorios.</p></div>
  <a class="btn btn-outline-secondary" href="{{ get_base_url() }}bienes">Cancelar</a>
</div>

<form method="post" action="{{ get_base_url() }}bienes/guardar{{ bien.id_bien ? '/' ~ bien.id_bien : '' }}" id="bienForm">
  <input type="hidden" name="csrf" value="{{ csrf }}">
  <input type="hidden" name="componentes" id="componentesInput" value="{{ componentes_json }}">
  <div class="card shadow-sm border-0 mb-4"><div class="card-header bg-white"><strong>1. Identificación</strong></div><div class="card-body row g-3">
    <div class="col-md-4"><label class="form-label">Clave interna CI</label><input class="form-control" value="{{ siguiente_ci }}" readonly><div class="form-text">Se genera automáticamente y no cambia al editar.</div></div>
    <div class="col-md-4"><label class="form-label">Inventario SICOPA *</label><input class="form-control" name="numero_inventario" required value="{{ bien.numero_inventario|default('') }}"></div>
    <div class="col-md-4"><label class="form-label">NIC / CEA</label><input class="form-control" name="nic_cea" value="{{ bien.nic_cea|default('') }}"></div>
    <div class="col-md-6"><label class="form-label">Número de serie</label><input class="form-control" name="numero_serie" value="{{ bien.numero_serie|default('') }}"></div>
    <div class="col-md-6"><label class="form-label">Nombre del bien *</label><input class="form-control" name="nombre_bien" required value="{{ bien.nombre_bien|default('') }}"></div>
  </div></div>

  <div class="card shadow-sm border-0 mb-4"><div class="card-header bg-white"><strong>2. Clasificación</strong></div><div class="card-body row g-3">
    <div class="col-md-4"><label class="form-label">Activo genérico</label><select class="form-select" id="activoGenerico"><option value="">Seleccionar...</option>{% for item in activos_genericos %}<option value="{{ item.id_activo_generico }}" {% if bien.id_activo_generico|default('') == item.id_activo_generico %}selected{% endif %}>{{ item.nombre }}</option>{% endfor %}</select></div>
    <div class="col-md-4"><label class="form-label">Grupo *</label><select class="form-select" name="id_grupo_activo" id="grupoActivo" required><option value="">Seleccionar...</option>{% for item in grupos %}<option value="{{ item.id_grupo_activo }}" {% if bien.id_grupo_activo|default('') == item.id_grupo_activo %}selected{% endif %}>{{ item.nombre }}</option>{% endfor %}</select></div>
    <div class="col-md-4"><label class="form-label">Activo específico *</label><input class="form-control" name="activo_especifico_nombre" id="activoEspecifico" list="activosEspecificos" required value="{{ bien.activo_especifico_nombre|default('') }}" placeholder="Escribe o elige una sugerencia"><datalist id="activosEspecificos">{% for item in activos_especificos %}<option data-grupo="{{ item.id_grupo_activo }}" value="{{ item.nombre }}"></option>{% endfor %}</datalist></div>
    <select id="gruposData" class="d-none">{% for item in todos_grupos %}<option data-generico="{{ item.id_activo_generico }}" value="{{ item.id_grupo_activo }}">{{ item.nombre }}</option>{% endfor %}</select>
    <div class="col-md-6"><label class="form-label">Marca</label><select class="form-select" name="id_marca" id="marcaBien"><option value="">Seleccionar...</option>{% for item in marcas %}<option value="{{ item.id_marca }}" {% if bien.id_marca|default('') == item.id_marca %}selected{% endif %}>{{ item.nombre }}</option>{% endfor %}</select></div>
    <div class="col-md-6"><label class="form-label">Modelo</label><input class="form-control" name="modelo_nombre" id="modeloBien" list="modelosBien" value="{{ bien.modelo_nombre|default('') }}" placeholder="Escribe o selecciona un modelo"><datalist id="modelosBien">{% for item in modelos %}<option data-marca="{{ item.id_marca }}" value="{{ item.nombre }}"></option>{% endfor %}</datalist><div class="form-text">Puedes capturar un modelo nuevo para la marca elegida.</div></div>
  </div></div>

  <div class="card shadow-sm border-0 mb-4"><div class="card-header bg-white"><strong>3. Información física</strong></div><div class="card-body row g-3">
    <div class="col-md-4"><label class="form-label">Material</label><input class="form-control" name="material" value="{{ bien.material|default('') }}"></div>
    <div class="col-md-4"><label class="form-label">Color</label><input class="form-control" name="color" value="{{ bien.color|default('') }}"></div>
    <div class="col-md-4"><label class="form-label">Estado de uso</label><select class="form-select" name="id_estado_uso"><option value="">Seleccionar...</option>{% for item in estados %}<option value="{{ item.id_estado_uso }}" {% if bien.id_estado_uso|default('') == item.id_estado_uso %}selected{% endif %}>{{ item.nombre }}</option>{% endfor %}</select></div>
    <div class="col-12"><label class="form-label">Características</label><textarea class="form-control" rows="3" name="caracteristicas">{{ bien.caracteristicas|default('S/C', true) }}</textarea><div class="form-text">Si no hay características por capturar, conserva S/C.</div></div>
  </div></div>

  <div class="card shadow-sm border-0 mb-4"><div class="card-header bg-white"><strong>4. Administración y ubicación</strong></div><div class="card-body row g-3">
    <div class="col-md-6"><label class="form-label">Código de Unidad Administrativa *</label><input class="form-control" name="codigo_ua" id="codigoUnidadBusqueda" list="unidadesAdministrativas" value="{{ bien.codigo_ua|default('') }}" placeholder="Busca por código o nombre" autocomplete="off" required><datalist id="unidadesAdministrativas">{% for item in unidades %}<option value="{{ item.codigo_ua }}" label="{{ item.nombre }}"></option>{% endfor %}</datalist><input type="hidden" name="id_unidad" id="idUnidad" value="{{ bien.id_unidad|default('') }}"><div class="form-text" id="nombreUnidadSeleccionada">{{ bien.unidad_nombre|default('') }}</div></div>
    <div class="col-md-3"><label class="form-label">Municipio</label><select class="form-select" id="municipioUbicacion"><option value="">Seleccionar...</option>{% for item in municipios %}<option value="{{ item.municipio }}" {% if bien.municipio|default('') == item.municipio %}selected{% endif %}>{{ item.municipio }}</option>{% endfor %}</select></div>
    <div class="col-md-3"><label class="form-label">Localidad</label><select class="form-select" name="id_ubicacion" id="localidadUbicacion"><option value="">Seleccionar...</option>{% for item in ubicaciones %}<option value="{{ item.id_ubicacion }}" data-municipio="{{ item.municipio }}" {% if bien.id_ubicacion|default('') == item.id_ubicacion %}selected{% endif %}>{{ item.localidad }}</option>{% endfor %}</select></div>
    <div class="col-md-4"><label class="form-label">Piso</label><input class="form-control" name="piso" value="{{ bien.piso|default('') }}"></div>
    <div class="col-md-4"><label class="form-label">Sección / Ala</label><input class="form-control" name="seccion_ala" value="{{ bien.seccion_ala|default('') }}"></div>
    <div class="col-md-4"><label class="form-label">Cubículo</label><input class="form-control" name="cubiculo" value="{{ bien.cubiculo|default('') }}"></div>
    <div class="col-12"><hr class="my-1"><p class="text-muted small mb-1">Datos administrativos derivados de la Unidad Administrativa seleccionada.</p></div>
    <div class="col-md-6"><label class="form-label">Secretaría</label><input class="form-control" id="uaSecretaria" readonly></div><div class="col-md-6"><label class="form-label">Subsecretaría</label><input class="form-control" id="uaSubsecretaria" readonly></div>
    <div class="col-md-6"><label class="form-label">Dirección de secretaría</label><input class="form-control" id="uaDireccion" readonly></div><div class="col-md-6"><label class="form-label">Dirección de área</label><input class="form-control" id="uaDireccionArea" readonly></div>
    <div class="col-md-6"><label class="form-label">Delegación Administrativa</label><input class="form-control" id="uaDelegacionAdministrativa" readonly></div><div class="col-md-6"><label class="form-label">Subdirección</label><input class="form-control" id="uaSubdireccion" readonly></div>
    <div class="col-md-6"><label class="form-label">Departamento</label><input class="form-control" id="uaDepartamento" readonly></div><div class="col-md-6"><label class="form-label">Oficina</label><input class="form-control" id="uaOficina" readonly></div>
    <div class="col-md-3"><label class="form-label">Valor</label><input type="number" min="0" step="0.01" class="form-control" name="valor" value="{{ bien.valor|default('') }}"></div>
    <div class="col-md-3"><label class="form-label">Fecha alta</label><input type="date" class="form-control" name="fecha_alta" value="{{ bien.fecha_alta|default('') }}"></div>
    <div class="col-md-3"><label class="form-label">Adquisición</label><input type="date" class="form-control" name="fecha_adquisicion" value="{{ bien.fecha_adquisicion|default('') }}"></div>
    <div class="col-md-3"><label class="form-label">Elaboración</label><input type="date" class="form-control" name="fecha_elaboracion" value="{{ bien.fecha_elaboracion|default('') }}"></div>
    <div class="col-12 form-check ms-2"><input class="form-check-input" type="checkbox" name="activo" id="activo" {{ bien.activo is not defined or bien.activo ? 'checked' : '' }}><label class="form-check-label" for="activo">Bien activo</label></div>
  </div></div>

  <div class="card shadow-sm border-0 mb-4"><div class="card-header bg-white d-flex justify-content-between align-items-center"><strong>5. Componentes</strong><button class="btn btn-sm btn-outline-secondary" type="button" id="agregarComponente">Agregar componente</button></div><div class="card-body pt-3"><p class="text-muted small">Registra los componentes que integran este bien.</p><div id="componentesConfig" data-componentes="{{ componentes_json }}"></div><div class="table-responsive"><table class="table table-bordered table-striped align-middle mb-0 bi-components-table"><thead class="table-light"><tr><th>Componente</th><th>Marca</th><th>Modelo</th><th>Serie</th><th>Inventario / Clave interna CI</th><th aria-label="Acciones"></th></tr></thead><tbody id="componentesLista"></tbody></table></div><datalist id="tiposComponente"><option value="CPU"><option value="CARGADOR"><option value="MONITOR"><option value="MOUSE"><option value="TECLADO"><option value="UPS"></datalist></div></div>

  <div class="card shadow-sm border-0 mb-4"><div class="card-header bg-white"><strong>6. Asignación y observaciones</strong></div><div class="card-body row g-3"><div class="col-md-8"><label class="form-label">Resguardante</label><select class="form-select" name="id_resguardante"><option value="">Pendiente de asignar...</option>{% for item in resguardantes %}<option value="{{ item.id_resguardante }}" {% if bien.id_resguardante|default('') == item.id_resguardante %}selected{% endif %}>{{ item.clave_interna }} · {{ item.nombre_completo }}</option>{% endfor %}</select></div><div class="col-md-4"><label class="form-label">Fecha de asignación</label><input class="form-control" type="date" name="fecha_asignacion" value="{{ bien.fecha_asignacion_actual|default(bien.fecha_asignacion|default('')) }}"></div><div class="col-12"><label class="form-label">Observaciones</label><textarea class="form-control" rows="3" name="observaciones">{{ bien.observaciones|default('') }}</textarea></div></div></div>
  <button class="btn bi-btn-primary" type="submit"><i class="fa-solid fa-floppy-disk me-1"></i>Guardar bien</button>
</form>
<div id="unidadesConfig" data-unidades="{{ unidades_json }}"></div>
{% include 'includes/admin/inventory-bottom.twig' %}
