{% include 'includes/admin/inventory-top.twig' %}
<div class="d-sm-flex align-items-center justify-content-between mb-4"><div><h1 class="h3 mb-1 bi-title">{{ bien.id_bien ? 'Editar bien' : 'Registrar bien' }}</h1><p class="text-muted mb-0">Los campos con asterisco son obligatorios.</p></div><a class="btn btn-outline-secondary" href="{{ get_base_url() }}bienes">Cancelar</a></div>
<form method="post" action="{{ get_base_url() }}bienes/guardar{{ bien.id_bien ? '/' ~ bien.id_bien : '' }}" id="bienForm"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="componentes" id="componentesInput" value="[]">
<div class="card shadow-sm border-0 mb-4"><div class="card-header bg-white"><strong>1. Identificación</strong></div><div class="card-body row g-3"><div class="col-md-4"><label class="form-label">CI / número de inventario *</label><input class="form-control" name="numero_inventario" required value="{{ siguiente_ci }}" {{ bien.id_bien ? 'readonly' : '' }}></div><div class="col-md-4"><label class="form-label">NIC / CEA</label><input class="form-control" name="nic_cea" value="{{ bien.nic_cea|default('') }}"></div><div class="col-md-4"><label class="form-label">Número de serie</label><input class="form-control" name="numero_serie" value="{{ bien.numero_serie|default('') }}"></div><div class="col-12"><label class="form-label">Nombre del bien *</label><input class="form-control" name="nombre_bien" required value="{{ bien.nombre_bien|default('') }}"></div></div></div>
<div class="card shadow-sm border-0 mb-4"><div class="card-header bg-white"><strong>2. Clasificación</strong></div><div class="card-body row g-3"><div class="col-md-4"><label class="form-label">Activo genérico</label><select class="form-select" id="activoGenerico"><option value="">Seleccionar...</option>{% for item in activos_genericos %}<option value="{{ item.id_activo_generico }}" {% if bien.id_activo_generico|default('') == item.id_activo_generico %}selected{% endif %}>{{ item.nombre }}</option>{% endfor %}</select></div><div class="col-md-4"><label class="form-label">Grupo *</label><select class="form-select" name="id_grupo_activo" id="grupoActivo" required><option value="">Seleccionar...</option>{% for item in grupos %}<option value="{{ item.id_grupo_activo }}" {% if bien.id_grupo_activo|default('') == item.id_grupo_activo %}selected{% endif %}>{{ item.nombre }}</option>{% endfor %}</select></div><div class="col-md-4"><label class="form-label">Activo específico *</label><input class="form-control" name="activo_especifico_nombre" id="activoEspecifico" list="activosEspecificos" required value="{{ bien.activo_especifico_nombre|default('') }}" placeholder="Escribe o elige una sugerencia"><datalist id="activosEspecificos">{% for item in activos_especificos %}<option data-grupo="{{ item.id_grupo_activo }}" value="{{ item.nombre }}"></option>{% endfor %}</datalist><div class="form-text">Puedes crear un activo específico nuevo al guardar.</div></div><select id="gruposData" class="d-none">{% for item in todos_grupos %}<option data-generico="{{ item.id_activo_generico }}" value="{{ item.id_grupo_activo }}">{{ item.nombre }}</option>{% endfor %}</select><div class="col-md-4"><label class="form-label">Marca</label><select class="form-select" name="id_marca"><option value="">Seleccionar...</option>{% for item in marcas %}<option value="{{ item.id_marca }}" {% if bien.id_marca|default('') == item.id_marca %}selected{% endif %}>{{ item.nombre }}</option>{% endfor %}</select></div><div class="col-md-4"><label class="form-label">Modelo</label><select class="form-select" name="id_modelo"><option value="">Seleccionar...</option>{% for item in modelos %}<option value="{{ item.id_modelo }}" {% if bien.id_modelo|default('') == item.id_modelo %}selected{% endif %}>{{ item.nombre }}</option>{% endfor %}</select></div></div></div>
<div class="card shadow-sm border-0 mb-4"><div class="card-header bg-white"><strong>3. Información física</strong></div><div class="card-body row g-3"><div class="col-md-4"><label class="form-label">Material</label><input class="form-control" name="material" value="{{ bien.material|default('') }}"></div><div class="col-md-4"><label class="form-label">Color</label><input class="form-control" name="color" value="{{ bien.color|default('') }}"></div><div class="col-md-4"><label class="form-label">Estado de uso</label><select class="form-select" name="id_estado_uso"><option value="">Seleccionar...</option>{% for item in estados %}<option value="{{ item.id_estado_uso }}" {% if bien.id_estado_uso|default('') == item.id_estado_uso %}selected{% endif %}>{{ item.nombre }}</option>{% endfor %}</select></div><div class="col-12"><label class="form-label">Características</label><textarea class="form-control" rows="3" name="caracteristicas">{{ bien.caracteristicas|default('') }}</textarea></div></div></div>
<div class="card shadow-sm border-0 mb-4"><div class="card-header bg-white"><strong>4. Administración</strong></div><div class="card-body row g-3"><div class="col-md-6"><label class="form-label">Unidad administrativa *</label><select class="form-select" name="id_unidad" required><option value="">Seleccionar...</option>{% for item in unidades %}<option value="{{ item.id_unidad }}" {% if bien.id_unidad|default('') == item.id_unidad %}selected{% endif %}>{{ item.codigo_ua }} · {{ item.nombre }}</option>{% endfor %}</select></div><div class="col-md-6"><label class="form-label">Ubicación física</label><select class="form-select" name="id_ubicacion"><option value="">Seleccionar...</option>{% for item in ubicaciones %}<option value="{{ item.id_ubicacion }}" {% if bien.id_ubicacion|default('') == item.id_ubicacion %}selected{% endif %}>{{ item.municipio }} · {{ item.localidad }}{{ item.ubicacion_fisica ? ' · ' ~ item.ubicacion_fisica : '' }}</option>{% endfor %}</select></div><div class="col-md-3"><label class="form-label">Valor</label><input type="number" min="0" step="0.01" class="form-control" name="valor" value="{{ bien.valor|default('') }}"></div><div class="col-md-3"><label class="form-label">Fecha alta</label><input type="date" class="form-control" name="fecha_alta" value="{{ bien.fecha_alta|default('') }}"></div><div class="col-md-3"><label class="form-label">Adquisición</label><input type="date" class="form-control" name="fecha_adquisicion" value="{{ bien.fecha_adquisicion|default('') }}"></div><div class="col-md-3"><label class="form-label">Elaboración</label><input type="date" class="form-control" name="fecha_elaboracion" value="{{ bien.fecha_elaboracion|default('') }}"></div><div class="col-12 form-check ms-2"><input class="form-check-input" type="checkbox" name="activo" id="activo" {{ bien.activo is not defined or bien.activo ? 'checked' : '' }}><label class="form-check-label" for="activo">Bien activo</label></div></div></div>
<div class="card shadow-sm border-0 mb-4"><div class="card-header bg-white"><strong>5. Observaciones y componentes</strong></div><div class="card-body"><textarea class="form-control mb-3" rows="3" name="observaciones" placeholder="Observaciones">{{ bien.observaciones|default('') }}</textarea><div class="form-check mb-3"><input class="form-check-input" type="checkbox" id="requiereComponentes"><label class="form-check-label" for="requiereComponentes">Requiere componentes</label></div><div id="componentesPanel" class="d-none"><button class="btn btn-sm btn-outline-secondary" type="button" id="agregarComponente">Agregar componente</button><div id="componentesLista" class="mt-3"></div></div></div></div>
<div class="card shadow-sm border-0 mb-4"><div class="card-header bg-white"><strong>Asignación</strong></div><div class="card-body"><label class="form-label">Resguardante</label><select class="form-select" name="id_resguardante"><option value="">Pendiente de asignar...</option>{% for item in resguardantes %}<option value="{{ item.id_resguardante }}" {% if bien.id_resguardante|default('') == item.id_resguardante %}selected{% endif %}>{{ item.clave_interna }} · {{ item.nombre_completo }}</option>{% endfor %}</select></div></div>
<button class="btn bi-btn-primary" type="submit"><i class="fa-solid fa-floppy-disk me-1"></i>Guardar bien</button></form>
{% include 'includes/admin/inventory-bottom.twig' %}
