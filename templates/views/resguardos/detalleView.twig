{% include 'includes/admin/inventory-top.twig' %}
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4"><div><a class="small text-muted" href="{{ get_base_url() }}resguardos"><i class="fa-solid fa-arrow-left me-1"></i>Volver a resguardos</a><h1 class="h3 bi-title mt-2 mb-1">Detalle del resguardante</h1><p class="text-muted mb-0">Asignaciones vigentes e historial de custodia.</p></div><div class="d-flex gap-2"><a class="btn btn-outline-secondary" href="{{ get_base_url() }}catalogos/resguardantes?editar={{ resguardo.id_resguardante }}"><i class="fa-solid fa-pen-to-square me-1"></i>Editar</a><span class="badge align-self-center {{ resguardo.activo ? 'text-bg-success' : 'text-bg-secondary' }}">{{ resguardo.activo ? 'Activo' : 'Inactivo' }}</span></div></div>
<section class="card shadow-sm border-0 mb-4"><div class="card-body"><div class="row g-3 align-items-center"><div class="col-md-6"><small class="text-muted d-block">Resguardante</small><strong class="fs-5 d-block">{{ resguardo.csp }}</strong><span>{{ resguardo.nombre_completo|title }}</span></div><div class="col-md-4"><small class="text-muted d-block">Unidad administrativa</small><strong>{{ resguardo.unidad_nombre|default('Sin unidad registrada') }}</strong><span class="d-block small text-muted">{{ resguardo.unidad_codigo_ua|default('Sin código UA') }}</span></div><div class="col-md-2"><small class="text-muted d-block">Bienes asignados</small><strong>{{ resguardo.bienes_asignados }}</strong><span class="small text-muted">({{ resguardo.bienes_activos }} activos)</span></div></div></div></section>
<section class="card shadow-sm border-0 mb-4"><header class="card-header bg-white"><h2 class="h6 mb-0">Asignaciones del resguardante</h2></header><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Bien</th><th>Identificadores</th><th>Unidad y ubicación</th><th>Asignación / devolución</th><th>Estado</th><th></th></tr></thead><tbody>
{% for item in resguardo.asignaciones %}<tr><td><strong>{{ item.nombre_bien|title }}</strong><small class="d-block text-muted">Serie: {{ item.numero_serie|default('—') }}</small></td><td>CI: {{ item.clave_interna|default('—') }}<small class="d-block text-muted">SICOPA: {{ item.numero_inventario|default('—') }}</small></td><td>{{ item.unidad_nombre|default('Sin unidad') }}<small class="d-block text-muted">{{ item.municipio|default('') }}{% if item.localidad %} · {{ item.localidad }}{% endif %}{% if item.piso %} · Piso {{ item.piso }}{% endif %}{% if item.seccion_ala %} · {{ item.seccion_ala }}{% endif %}{% if item.cubiculo %} · Cubículo {{ item.cubiculo }}{% endif %}</small></td><td>{{ item.fecha_asignacion ? item.fecha_asignacion|date('d/m/Y') : '—' }}<small class="d-block text-muted">Devolución: {{ item.fecha_devolucion ? item.fecha_devolucion|date('d/m/Y') : '—' }}</small></td><td><span class="badge {{ item.activo ? 'text-bg-primary' : 'text-bg-secondary' }}">{{ item.activo ? 'Resguardo vigente' : 'Resguardo cerrado' }}</span><small class="d-block text-muted">Bien {{ item.bien_activo ? 'activo' : 'inactivo' }}</small></td><td><a class="btn btn-sm btn-outline-secondary" href="{{ get_base_url() }}bienes/detalle/{{ item.id_bien }}">Ver bien</a></td></tr>
{% else %}<tr><td colspan="6" class="text-center text-muted py-4">Este resguardante no tiene asignaciones registradas.</td></tr>{% endfor %}
</tbody></table></div></section>
<section class="card shadow-sm border-0"><header class="card-header bg-white"><h2 class="h6 mb-0">Movimientos relacionados</h2></header><div class="list-group list-group-flush">{% for movimiento in resguardo.movimientos %}<a class="list-group-item list-group-item-action d-flex flex-wrap justify-content-between gap-2" href="{{ get_base_url() }}historico-movimientos/detalle/{{ movimiento.id_movimiento }}"><span><strong>{{ movimiento.tipo_movimiento }}</strong><small class="d-block text-muted">{{ movimiento.clave_interna|default('') }} · {{ movimiento.nombre_bien|default('Bien') }}</small></span><span class="text-muted">{{ movimiento.fecha_movimiento|date('d/m/Y H:i') }}</span></a>{% else %}<div class="list-group-item text-muted">No hay movimientos asociados al resguardante.</div>{% endfor %}</div></section>
{% include 'includes/admin/inventory-bottom.twig' %}
