{% include 'includes/admin/inventory-top.twig' %}
<h1 class="h3 bi-title mb-4">Resguardos</h1><ul class="nav nav-tabs mb-3"><li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#vigentes">Custodia vigente</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#historico">Histórico</button></li></ul><div class="tab-content"><div class="tab-pane fade show active" id="vigentes"><div class="card shadow-sm border-0"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Resguardante</th><th>CI</th><th>Inventario SICOPA</th><th>Bien</th><th>Unidad</th><th>Asignación</th></tr></thead><tbody>{% for item in vigentes %}<tr><td>{{ item.resguardante_nombre }}</td><td>{{ item.clave_interna|default('—') }}</td><td>{{ item.numero_inventario|default('—') }}</td><td>{{ item.nombre_bien }}</td><td>{{ item.codigo_ua }} · {{ item.unidad_nombre }}</td><td>{{ item.fecha_asignacion|default('—') }}</td></tr>{% else %}<tr><td colspan="6" class="text-center py-4 text-muted">No hay resguardos vigentes.</td></tr>{% endfor %}</tbody></table></div></div></div><div class="tab-pane fade" id="historico"><div class="card shadow-sm border-0"><div class="card-body"><ul class="bi-timeline">{% for item in historico %}<li><strong>{{ item.tipo_movimiento }}</strong><span>{{ item.fecha_movimiento|date('d/m/Y H:i') }}</span><p>{{ item.motivo|default(item.observaciones|default('')) }}</p></li>{% else %}<li>Sin movimientos registrados.</li>{% endfor %}</ul></div></div></div></div>
{% include 'includes/admin/inventory-bottom.twig' %}
