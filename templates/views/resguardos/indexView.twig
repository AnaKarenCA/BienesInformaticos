{% include 'includes/admin/inventory-top.twig' %}
<div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4">
  <div><h1 class="h3 bi-title mb-1">Resguardos</h1><p class="text-muted mb-0">Consulta quién tiene bienes asignados y accede al detalle de su custodia.</p></div>
  <div class="d-flex align-items-center gap-2"><span class="badge text-bg-light" data-resguardo-count>{{ resguardantes|length }} resguardantes</span><a class="btn btn-outline-secondary" href="{{ get_base_url() }}historico-movimientos"><i class="fa-solid fa-clock-rotate-left me-1"></i>Histórico de movimientos</a></div>
</div>
<div class="card shadow-sm border-0 mb-4"><div class="card-body"><div class="row g-2">
  <div class="col-lg-6"><label class="visually-hidden" for="buscarResguardos">Buscar por CSP, nombre o unidad administrativa</label><input class="form-control" type="search" id="buscarResguardos" data-resguardo-search placeholder="Buscar por CSP, nombre o unidad administrativa" autocomplete="off"></div>
  <div class="col-md-6 col-lg-3"><label class="visually-hidden" for="filtroEstadoResguardos">Estado</label><select class="form-select" id="filtroEstadoResguardos" data-resguardo-state><option value="1" selected>Activos</option><option value="0">Inactivos</option><option value="">Todos</option></select></div>
</div></div></div>
<div class="card shadow-sm border-0"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Resguardante</th><th>Unidad administrativa</th><th>Bienes bajo resguardo</th><th>Última asignación</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead><tbody data-resguardo-list>
{% for item in resguardantes %}
<tr data-resguardo-card data-state="{{ item.activo ? '1' : '0' }}" data-search="{{ (item.csp ~ ' ' ~ item.nombre_completo ~ ' ' ~ (item.unidad_nombre|default('')) ~ ' ' ~ (item.unidad_codigo_ua|default('')))|lower }}">
  <td><strong class="d-block">{{ item.csp }}</strong><span class="text-muted small">{{ item.nombre_completo|title }}</span></td>
  <td>{{ item.unidad_nombre|default('Sin unidad registrada') }}<small class="d-block text-muted">{{ item.unidad_codigo_ua|default('Sin código UA') }}</small></td>
  <td><strong>{{ item.bienes_asignados }}</strong> asignados<small class="d-block text-muted">{{ item.bienes_activos }} bienes activos</small></td>
  <td>{{ item.ultima_asignacion ? item.ultima_asignacion|date('d/m/Y') : '—' }}</td>
  <td><span class="badge {{ item.activo ? 'text-bg-success' : 'text-bg-secondary' }}">{{ item.activo ? 'Activo' : 'Inactivo' }}</span></td>
  <td class="text-end text-nowrap"><a class="btn btn-sm btn-outline-primary" href="{{ get_base_url() }}resguardos/detalle/{{ item.id_resguardante }}" title="Ver detalle" aria-label="Ver detalle" data-bs-toggle="tooltip" data-bs-trigger="hover focus" data-bs-title="Ver detalle"><i class="fa-solid fa-eye" aria-hidden="true"></i></a> <a class="btn btn-sm btn-outline-secondary" href="{{ get_base_url() }}catalogos/resguardantes?editar={{ item.id_resguardante }}" title="Editar" aria-label="Editar" data-bs-toggle="tooltip" data-bs-trigger="hover focus" data-bs-title="Editar"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i></a>
  {% if item.activo %}{% if item.bienes_asignados > 0 %}<a class="btn btn-sm btn-outline-danger" href="{{ get_base_url() }}catalogos/cambiar_resguardante/{{ item.id_resguardante }}" title="Reasignar y desactivar" aria-label="Reasignar y desactivar" data-bs-toggle="tooltip" data-bs-trigger="hover focus" data-bs-title="Reasignar y desactivar"><i class="fa-solid fa-arrow-right-arrow-left" aria-hidden="true"></i></a>{% else %}<a class="btn btn-sm btn-outline-danger" href="{{ get_base_url() }}catalogos/cambiar_estado/resguardante/{{ item.id_resguardante }}?_t={{ csrf }}" onclick="return confirm('¿Desactivar a {{ item.nombre_completo|e('js') }}?')" title="Desactivar" aria-label="Desactivar" data-bs-toggle="tooltip" data-bs-trigger="hover focus" data-bs-title="Desactivar"><i class="fa-solid fa-user-slash" aria-hidden="true"></i></a>{% endif %}{% else %}<a class="btn btn-sm btn-outline-success" href="{{ get_base_url() }}catalogos/cambiar_estado/resguardante/{{ item.id_resguardante }}?_t={{ csrf }}" title="Activar" aria-label="Activar" data-bs-toggle="tooltip" data-bs-trigger="hover focus" data-bs-title="Activar"><i class="fa-solid fa-user-check" aria-hidden="true"></i></a>{% endif %}</td>
</tr>
{% else %}<tr><td colspan="6" class="text-center text-muted py-4">No hay resguardantes registrados.</td></tr>{% endfor %}
<tr class="d-none" data-resguardo-empty><td colspan="6" class="text-center text-muted py-4">No hay resguardantes que coincidan con los filtros.</td></tr>
</tbody></table></div></div>
<script src="{{ get_base_url() }}assets/js/resguardos.js?v={{ get_asset_version() }}"></script>
{% include 'includes/admin/inventory-bottom.twig' %}
