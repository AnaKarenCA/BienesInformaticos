<div class="card shadow-sm border-0"><div class="card-body"><form method="get"><label class="form-label">Bien</label><div class="input-group"><select class="form-select" name="id"><option value="">Seleccionar bien...</option>{% for item in bienes %}<option value="{{ item.id_bien }}" {% if bien.id_bien|default('') == item.id_bien %}selected{% endif %}>{{ item.clave_interna|default('Sin CI') }} · {{ item.nombre_bien }}</option>{% endfor %}</select><button class="btn bi-btn-primary">Continuar</button></div></form>{% if bien %}<hr><form method="post" action="{{ get_base_url() }}reportes/documento/{{ tipo }}/{{ bien.id_bien }}"><input type="hidden" name="csrf" value="{{ csrf }}"><div class="row"><div class="col-md-8"><h2 class="h5">{{ bien.nombre_bien }}</h2><p class="mb-1"><strong>CI:</strong> {{ bien.clave_interna|default('—') }}</p><p class="mb-1"><strong>Inventario SICOPA:</strong> {{ bien.numero_inventario|default('—') }}</p><p class="mb-1"><strong>Resguardante:</strong> {{ bien.resguardante_nombre|default('Pendiente') }}</p><p class="mb-0"><strong>Unidad:</strong> {{ bien.codigo_ua }} · {{ bien.unidad_nombre }}</p></div><div class="col-md-4"><label class="form-label">Observaciones del documento</label><textarea class="form-control" name="observaciones" rows="3"></textarea></div></div>{% if tipo == 'baja' %}<div class="row g-2 mt-2"><div class="col-md-4"><label class="form-label">Fecha de baja</label><input class="form-control" type="date" name="fecha_baja" value="{{ 'now'|date('Y-m-d') }}"></div><div class="col-md-8"><label class="form-label">Motivo de baja</label><input class="form-control" name="motivo"></div><div class="col-12 form-check ms-2"><input class="form-check-input" type="checkbox" name="confirmar_baja" value="1" id="confirmarBaja"><label class="form-check-label" for="confirmarBaja">Confirmo que la custodia debe quedar dada de baja.</label></div></div>{% endif %}<div class="mt-3"><button class="btn bi-btn-primary"><i class="fa-solid fa-file-pdf"></i> Generar PDF</button></div></form>{% endif %}</div></div>
