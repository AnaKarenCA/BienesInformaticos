{% include 'includes/admin/inventory-top.twig' %}
<div class="d-sm-flex align-items-center justify-content-between mb-4"><div><h1 class="h3 mb-1 bi-title">Panel de inventario</h1><p class="text-muted mb-0">Resumen operativo de bienes informáticos.</p></div><a class="btn bi-btn-primary" href="{{ get_base_url() }}bienes/registrar"><i class="fa-solid fa-plus me-1"></i>Registrar bien</a></div>
<div class="row g-3 mb-4"><div class="col-md-6 col-xl-3"><div class="card shadow-sm border-0"><div class="card-body"><small class="text-muted">Total de bienes</small><h2 class="mb-0">{{ resumen.total }}</h2></div></div></div><div class="col-md-6 col-xl-3"><div class="card shadow-sm border-0"><div class="card-body"><small class="text-muted">Activos</small><h2 class="mb-0">{{ resumen.activos }}</h2></div></div></div><div class="col-md-6 col-xl-3"><div class="card shadow-sm border-0"><div class="card-body"><small class="text-muted">Con resguardante</small><h2 class="mb-0">{{ resumen.con_resguardante }}</h2></div></div></div><div class="col-md-6 col-xl-3"><div class="card shadow-sm border-0"><div class="card-body"><small class="text-muted">Pendientes de asignar</small><h2 class="mb-0">{{ resumen.pendientes }}</h2></div></div></div></div>
<div class="card shadow-sm border-0"><div class="card-header bg-white"><h6 class="m-0 bi-title">Últimos 5 bienes registrados o modificados</h6></div><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>CI</th><th>Inventario SICOPA</th><th>Bien</th><th>Unidad</th><th>Fecha</th><th></th></tr></thead><tbody>{% for bien in recientes %}<tr><td><strong>{{ bien.clave_interna|default('—') }}</strong></td><td>{{ bien.numero_inventario|default('—') }}</td><td>{{ bien.nombre_bien }}</td><td>{{ bien.codigo_ua }} · {{ bien.unidad_nombre }}</td><td>{{ bien.fecha_registro|date('d/m/Y H:i') }}</td><td><a href="{{ get_base_url() }}bienes/detalle/{{ bien.id_bien }}" class="btn btn-sm btn-outline-secondary">Ver</a></td></tr>{% else %}<tr><td colspan="6" class="text-center text-muted py-4">Aún no hay bienes registrados.</td></tr>{% endfor %}</tbody></table></div></div>
{% include 'includes/admin/inventory-bottom.twig' %}
