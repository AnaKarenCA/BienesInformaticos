{% include 'includes/admin/inventory-top.twig' %}
<div class="d-sm-flex align-items-center justify-content-between mb-4"><div><h1 class="h3 mb-1 bi-title">Inicio</h1><p class="text-muted mb-0">Resumen del inventario de bienes informáticos.</p></div><a class="btn bi-btn-primary" href="{{ get_base_url() }}bienes/registrar"><i class="fa-solid fa-plus me-1"></i>Registrar bien</a></div>
<div class="row">
  <div class="col-xl-4 col-md-6 mb-4"><div class="card bi-stat-card border-left-primary h-100 py-2"><div class="card-body"><div class="text-xs font-weight-bold text-uppercase mb-1">Total de bienes</div><div class="h3 mb-0 font-weight-bold">{{ resumen.total }}</div></div></div></div>
  <div class="col-xl-4 col-md-6 mb-4"><div class="card bi-stat-card border-left-warning h-100 py-2"><div class="card-body"><div class="text-xs font-weight-bold text-uppercase mb-1">Pendientes</div><div class="h3 mb-0 font-weight-bold">{{ resumen.pendientes }}</div></div></div></div>
  <div class="col-xl-4 col-md-6 mb-4"><div class="card bi-stat-card border-left-success h-100 py-2"><div class="card-body"><div class="text-xs font-weight-bold text-uppercase mb-1">Con resguardante</div><div class="h3 mb-0 font-weight-bold">{{ resumen.con_resguardante }}</div></div></div></div>
</div>
<div class="card shadow-sm border-0 mb-4"><div class="card-body py-3 d-flex flex-wrap gap-2"><a href="{{ get_base_url() }}identificar" class="btn btn-outline-secondary"><i class="fa-solid fa-barcode me-1"></i>Identificar bien</a><a href="{{ get_base_url() }}resguardos/baja_resguardante" class="btn btn-outline-secondary"><i class="fa-solid fa-file-circle-minus me-1"></i>Baja resguardante</a><a href="{{ get_base_url() }}resguardos/tarjeta" class="btn btn-outline-secondary"><i class="fa-solid fa-id-card me-1"></i>Tarjeta de resguardo</a><a href="{{ get_base_url() }}resguardos/resguardo_equipo" class="btn btn-outline-secondary"><i class="fa-solid fa-file-signature me-1"></i>Resguardo del equipo</a></div></div>
<div class="card shadow-sm border-0"><div class="card-header bg-white"><h6 class="m-0 bi-title">Últimos 5 bienes registrados o modificados</h6></div><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>CI</th><th>Bien</th><th>Unidad</th><th>Fecha</th><th></th></tr></thead><tbody>{% for bien in recientes %}<tr><td><strong>{{ bien.numero_inventario }}</strong></td><td>{{ bien.nombre_bien }}</td><td>{{ bien.codigo_ua }} · {{ bien.unidad_nombre }}</td><td>{{ bien.fecha_registro|date('d/m/Y H:i') }}</td><td><a href="{{ get_base_url() }}bienes/detalle/{{ bien.id_bien }}" class="btn btn-sm btn-outline-secondary">Ver</a></td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-4">Aún no hay bienes registrados.</td></tr>{% endfor %}</tbody></table></div></div>
{% include 'includes/admin/inventory-bottom.twig' %}
