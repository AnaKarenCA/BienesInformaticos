{% include 'includes/admin/inventory-top.twig' %}
<h1 class="h3 bi-title mb-1">Unidades administrativas</h1><p class="text-muted mb-4">Estructura jerárquica por código de unidad.</p><div class="card shadow-sm border-0"><div class="card-body border-bottom"><form class="row g-2" method="post" action="{{ get_base_url() }}catalogos/guardar/unidad"><input type="hidden" name="csrf" value="{{ csrf }}"><div class="col-md-2"><input class="form-control" name="codigo_ua" required placeholder="Código"></div><div class="col-md-4"><input class="form-control" name="nombre" required placeholder="Nombre de unidad"></div><div class="col-md-2"><select class="form-select" name="tipo"><option value="L">Localidad</option><option value="S">Subunidad</option></select></div><div class="col-md-3"><select class="form-select" name="id_padre"><option value="">Sin unidad padre</option>{% for item in unidades %}<option value="{{ item.id_unidad }}">{{ item.codigo_ua }} · {{ item.nombre }}</option>{% endfor %}</select></div><div class="col-md-1"><button class="btn bi-btn-primary w-100">+</button></div></form></div><ul class="list-group list-group-flush">{% for item in unidades %}<li class="list-group-item d-flex justify-content-between"><span><strong>{{ item.codigo_ua }}</strong> · {{ item.nombre }}</span><span class="badge bi-badge">{{ item.tipo|default('—') }}</span></li>{% else %}<li class="list-group-item text-muted">Sin registros.</li>{% endfor %}</ul></div>
{% include 'includes/admin/inventory-bottom.twig' %}
