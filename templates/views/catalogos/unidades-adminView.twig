{% include 'includes/admin/inventory-top.twig' %}
<h1 class="h3 bi-title mb-1">Unidades administrativas</h1><p class="text-muted mb-4">Estructura administrativa existente por Código de Unidad Administrativa y relación padre-hija.</p>
<div class="card shadow-sm border-0"><div class="card-body border-bottom"><form class="row g-2" method="post" action="{{ get_base_url() }}catalogos/guardar/unidad"><input type="hidden" name="csrf" value="{{ csrf }}"><div class="col-md-3"><input class="form-control" name="codigo_ua" required placeholder="Código UA"></div><div class="col-md-5"><input class="form-control" name="nombre" required placeholder="Nombre de unidad"></div><div class="col-md-3"><select class="form-select" name="id_padre"><option value="">Sin unidad padre</option>{% for item in unidades %}<option value="{{ item.id_unidad }}">{{ item.codigo_ua }} · {{ item.nombre }}</option>{% endfor %}</select></div><div class="col-md-1"><button class="btn bi-btn-primary w-100">+</button></div></form></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Código UA</th><th>Unidad</th><th>Unidad padre</th></tr></thead><tbody>{% for item in unidades %}<tr><td><strong>{{ item.codigo_ua }}</strong></td><td>{{ item.nombre }}</td><td>{% for padre in unidades %}{% if padre.id_unidad == item.id_padre %}{{ padre.codigo_ua }} · {{ padre.nombre }}{% endif %}{% endfor %}</td></tr>{% else %}<tr><td colspan="3" class="text-center text-muted">Sin registros.</td></tr>{% endfor %}</tbody></table></div></div>
{% include 'includes/admin/inventory-bottom.twig' %}
