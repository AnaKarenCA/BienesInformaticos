{% include 'includes/admin/inventory-top.twig' %}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
  <div><h1 class="h3 bi-title mb-1">Unidades administrativas</h1><p class="text-muted mb-0">Consulta y administra las unidades conservando su jerarquía.</p></div>
  <div class="d-flex flex-wrap gap-2"><input class="form-control" style="width:min(100%,360px)" type="search" data-global-catalog-search placeholder="Buscar por código o nombre..." aria-label="Buscar unidades por código o nombre"><button type="button" class="btn bi-btn-primary" data-catalog-add="unidad" data-catalog-label="unidad administrativa" data-bs-toggle="modal" data-bs-target="#unidadModal"><i class="fa-solid fa-plus me-1"></i>Nueva unidad administrativa</button></div>
</div>
<section class="card shadow-sm border-0"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Código UA</th><th>Nombre</th><th>Unidad padre</th><th class="text-end">Acciones</th></tr></thead><tbody data-catalog-table>
{% for item in unidades %}<tr data-catalog-row><td><span class="fw-semibold">{{ item.codigo_ua|default('Sin código UA') }}</span></td><td>{{ item.nombre }}</td><td>{{ item.padre_nombre|default('—') }}</td><td class="text-end text-nowrap"><button type="button" class="btn btn-sm btn-outline-secondary" data-catalog-edit="unidad" data-catalog-label="unidad administrativa" data-id="{{ item.id_unidad }}" data-name="{{ item.nombre }}" data-codigo-ua="{{ item.codigo_ua|default('') }}" data-parent="{{ item.id_padre|default('') }}" data-bs-toggle="modal" data-bs-target="#unidadModal" title="Editar unidad"><i class="fa-solid fa-pen-to-square me-1"></i>Editar</button> <form class="d-inline" method="post" action="{{ get_base_url() }}catalogos/eliminar_unidad/{{ item.id_unidad }}" onsubmit="return confirm('Solo se eliminará si no tiene bienes, resguardantes ni unidades dependientes. ¿Continuar?')"><input type="hidden" name="csrf" value="{{ csrf }}"><button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar si no tiene dependencias"><i class="fa-solid fa-trash-can me-1"></i>Eliminar</button></form></td></tr>
{% else %}<tr data-catalog-no-records><td colspan="4" class="text-center text-muted py-4">Sin registros.</td></tr>{% endfor %}<tr class="d-none" data-search-empty><td colspan="4" class="text-center text-muted py-4">Sin coincidencias.</td></tr>
</tbody></table></div></section>
<div class="modal fade" id="unidadModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><form method="post" action="{{ get_base_url() }}catalogos/guardar/unidad" data-catalog-form="unidad"><input type="hidden" name="csrf" value="{{ csrf }}"><div class="modal-header"><h2 class="modal-title fs-5" data-catalog-title>Nueva unidad administrativa</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div><div class="modal-body"><label class="form-label" for="unidadNombre">Nombre</label><input class="form-control mb-3" id="unidadNombre" name="nombre" required maxlength="250"><label class="form-label" for="unidadCodigo">Código UA <span class="text-muted">(opcional)</span></label><input class="form-control mb-3" id="unidadCodigo" name="codigo_ua" maxlength="20"><label class="form-label" for="unidadPadre">Unidad padre</label><select class="form-select" id="unidadPadre" name="id_padre"><option value="">Sin unidad padre</option>{% for padre in unidades_para_padre %}<option value="{{ padre.id_unidad }}">{{ padre.codigo_ua|default('Sin código UA') }} · {{ padre.nombre }}</option>{% endfor %}</select><div class="form-text">La unidad padre conserva la relación jerárquica entre unidades.</div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button><button type="submit" class="btn bi-btn-primary"><i class="fa-solid fa-floppy-disk me-1"></i><span data-submit-label>Guardar</span></button></div></form></div></div></div>
{% include 'includes/admin/inventory-bottom.twig' %}
