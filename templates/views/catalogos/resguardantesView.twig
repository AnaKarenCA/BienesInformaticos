{% include 'includes/admin/inventory-top.twig' %}
<header class="bi-list-heading"><h1 class="h3 mb-1 bi-title">Catálogo De Resguardantes</h1><p class="text-muted mb-0">Identifica cada resguardante mediante su CSP.</p></header><div class="bi-list-controls mb-4"><form class="catalog-global-search" data-live-resguardante-search role="search"><label class="visually-hidden" for="buscarResguardante">Buscar Resguardante</label><input class="form-control" id="buscarResguardante" type="search" value="{{ busqueda }}" data-resguardante-search placeholder="Buscar por CSP, nombre o unidad" autocomplete="off"></form>{% if can_manage_catalogs|default(false) %}<button class="btn bi-btn-primary bi-button-label" type="button" data-bs-toggle="modal" data-bs-target="#resguardanteModal" data-new-resguardante title="Agregar Resguardante" aria-label="+ Agregar Resguardante">+ Agregar Resguardante</button>{% endif %}</div>
<div class="card shadow-sm border-0"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>CSP</th><th>Nombre Completo</th><th>Unidad Administrativa</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>{% for item in resguardantes %}<tr data-resguardante-row data-search="{{ (item.csp ~ ' ' ~ item.nombre_completo ~ ' ' ~ (item.unidad_nombre|default('')) ~ ' ' ~ (item.unidad_codigo_ua|default('')))|lower }}"><td><strong>{{ item.csp }}</strong></td><td>{{ item.nombre_completo|title }}</td><td>{{ item.unidad_codigo_ua|default('') }} {{ item.unidad_nombre|default('Unidad No Asignada')|title }}</td><td><span class="badge {{ item.activo ? 'text-bg-success' : 'text-bg-secondary' }}">{{ item.activo ? 'Activo' : 'Inactivo' }}</span></td><td class="text-nowrap">{% if can_manage_catalogs|default(false) %}<button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#resguardanteModal" data-edit-resguardante data-id="{{ item.id_resguardante }}" data-csp="{{ item.csp }}" data-nombre="{{ item.nombre }}" data-paterno="{{ item.apellido_paterno }}" data-materno="{{ item.apellido_materno|default('') }}" data-unidad="{{ item.id_unidad|default('') }}" title="Editar" aria-label="Editar"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i><span class="visually-hidden">Editar</span></button>{% endif %}{% if item.activo %}{% if item.bienes_vigentes > 0 %}{% if can_change_custody|default(false) %}<button class="btn btn-sm btn-outline-danger" type="button" data-bs-toggle="modal" data-bs-target="#resguardanteConBienesModal" data-transfer-url="{{ get_base_url() }}catalogos/cambiar_resguardante/{{ item.id_resguardante }}" title="Desactivar" aria-label="Desactivar"><i class="fa-solid fa-user-slash" aria-hidden="true"></i><span class="visually-hidden">Desactivar</span></button>{% endif %}{% else %}{% if can_change_custody|default(false) %}<a class="btn btn-sm btn-outline-danger" href="{{ get_base_url() }}catalogos/cambiar_estado/resguardante/{{ item.id_resguardante }}?_t={{ csrf }}" onclick="return confirm('¿Deseas desactivar este resguardante?')" title="Desactivar" aria-label="Desactivar"><i class="fa-solid fa-user-slash" aria-hidden="true"></i><span class="visually-hidden">Desactivar</span></a>{% endif %}{% endif %}{% else %}{% if can_change_custody|default(false) %}<a class="btn btn-sm btn-outline-success" href="{{ get_base_url() }}catalogos/cambiar_estado/resguardante/{{ item.id_resguardante }}?_t={{ csrf }}" onclick="return confirm('¿Deseas activar este resguardante?')" title="Activar" aria-label="Activar"><i class="fa-solid fa-user-check" aria-hidden="true"></i><span class="visually-hidden">Activar</span></a>{% endif %}{% endif %}</td></tr>{% else %}<tr><td colspan="5" class="text-center py-5 text-muted">No hay resguardantes registrados.</td></tr>{% endfor %}<tr class="d-none" data-resguardante-no-results><td colspan="5" class="text-center py-4 text-muted">No hay resguardantes que coincidan con la búsqueda.</td></tr></tbody></table></div></div>
{% include 'views/catalogos/_resguardante-form.twig' with {resguardante_ajax: false, unidades_resguardante: unidades} %}
<div class="modal fade" id="resguardanteConBienesModal" tabindex="-1" aria-labelledby="resguardanteConBienesTitulo" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5" id="resguardanteConBienesTitulo">El Resguardante Tiene Bienes Resguardados</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Cancelar"></button></div><div class="modal-body">El resguardante tiene bienes resguardados. Debes transferirlos antes de desactivarlo.</div><div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal" title="Cancelar">Cancelar</button><a class="btn btn-danger" id="iniciarTransferenciaResguardante" href="#" title="Cambiar Resguardante Y Desactivar">Cambiar Resguardante Y Desactivar</a></div></div></div></div>
<script>document.addEventListener('click', event => { const trigger = event.target.closest('[data-transfer-url]'); if (trigger) document.querySelector('#iniciarTransferenciaResguardante')?.setAttribute('href', trigger.dataset.transferUrl); });</script>
{% include 'includes/admin/inventory-bottom.twig' %}
