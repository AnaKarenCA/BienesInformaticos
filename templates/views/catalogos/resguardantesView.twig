{% include 'includes/admin/inventory-top.twig' %}
<div class="d-sm-flex align-items-center justify-content-between mb-4"><div><h1 class="h3 mb-1 bi-title">Catálogo De Resguardantes</h1><p class="text-muted mb-0">Identifica cada resguardante mediante su CSP.</p></div><button class="btn bi-btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#resguardanteModal" data-new-resguardante title="Agregar Resguardante" aria-label="Agregar Resguardante"><i class="fa-solid fa-plus" aria-hidden="true"></i><span class="visually-hidden">Agregar Resguardante</span></button></div>
<form class="card shadow-sm border-0 mb-4" method="get"><div class="card-body row g-2"><div class="col-md-10"><label class="visually-hidden" for="buscarResguardante">Buscar Resguardante</label><input class="form-control" id="buscarResguardante" name="q" value="{{ busqueda }}" placeholder="Buscar por CSP, nombre o unidad"></div><div class="col-md-2"><button class="btn bi-btn-primary w-100" title="Buscar" aria-label="Buscar"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button></div></div></form>
<div class="card shadow-sm border-0"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>CSP</th><th>Nombre Completo</th><th>Unidad Administrativa</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>{% for item in resguardantes %}<tr><td><strong>{{ item.csp }}</strong></td><td>{{ item.nombre_completo|title }}</td><td>{{ item.unidad_codigo_ua|default('') }} {{ item.unidad_nombre|default('Unidad No Asignada')|title }}</td><td><span class="badge {{ item.activo ? 'text-bg-success' : 'text-bg-secondary' }}">{{ item.activo ? 'Activo' : 'Inactivo' }}</span></td><td class="text-nowrap"><button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#resguardanteModal" data-edit-resguardante data-id="{{ item.id_resguardante }}" data-csp="{{ item.csp }}" data-nombre="{{ item.nombre }}" data-paterno="{{ item.apellido_paterno }}" data-materno="{{ item.apellido_materno|default('') }}" data-unidad="{{ item.id_unidad|default('') }}" title="Editar" aria-label="Editar"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i><span class="visually-hidden">Editar</span></button>{% if item.activo %}{% if item.bienes_vigentes > 0 %}<button class="btn btn-sm btn-outline-danger" type="button" data-bs-toggle="modal" data-bs-target="#resguardanteConBienesModal" data-transfer-url="{{ get_base_url() }}catalogos/cambiar_resguardante/{{ item.id_resguardante }}" title="Desactivar" aria-label="Desactivar"><i class="fa-solid fa-user-slash" aria-hidden="true"></i><span class="visually-hidden">Desactivar</span></button>{% else %}<a class="btn btn-sm btn-outline-danger" href="{{ get_base_url() }}catalogos/cambiar_estado/resguardante/{{ item.id_resguardante }}?_t={{ csrf }}" onclick="return confirm('¿Deseas desactivar este resguardante?')" title="Desactivar" aria-label="Desactivar"><i class="fa-solid fa-user-slash" aria-hidden="true"></i><span class="visually-hidden">Desactivar</span></a>{% endif %}{% else %}<a class="btn btn-sm btn-outline-success" href="{{ get_base_url() }}catalogos/cambiar_estado/resguardante/{{ item.id_resguardante }}?_t={{ csrf }}" onclick="return confirm('¿Deseas activar este resguardante?')" title="Activar" aria-label="Activar"><i class="fa-solid fa-user-check" aria-hidden="true"></i><span class="visually-hidden">Activar</span></a>{% endif %}</td></tr>{% else %}<tr><td colspan="5" class="text-center py-5 text-muted">No hay resguardantes registrados.</td></tr>{% endfor %}</tbody></table></div></div>
{% include 'views/catalogos/_resguardante-form.twig' with {resguardante_ajax: false, unidades_resguardante: unidades} %}
<div class="modal fade" id="resguardanteConBienesModal" tabindex="-1" aria-labelledby="resguardanteConBienesTitulo" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5" id="resguardanteConBienesTitulo">El Resguardante Tiene Bienes Resguardados</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Cancelar"></button></div><div class="modal-body">El resguardante tiene bienes resguardados. Debes transferirlos antes de desactivarlo.</div><div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal" title="Cancelar">Cancelar</button><a class="btn btn-danger" id="iniciarTransferenciaResguardante" href="#" title="Cambiar Resguardante Y Desactivar">Cambiar Resguardante Y Desactivar</a></div></div></div></div>
<script>document.addEventListener('click', event => { const trigger = event.target.closest('[data-transfer-url]'); if (trigger) document.querySelector('#iniciarTransferenciaResguardante')?.setAttribute('href', trigger.dataset.transferUrl); });</script>
{% include 'includes/admin/inventory-bottom.twig' %}
