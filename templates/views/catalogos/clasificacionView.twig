{% include 'includes/admin/inventory-top.twig' %}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><h1 class="h3 bi-title mb-1">Clasificación De Activos</h1><p class="text-muted mb-0">Activo genérico → grupo → activo específico.</p></div><div class="catalog-global-search"><label class="visually-hidden" for="catalogoBusqueda">Buscar En Clasificación</label><input class="form-control" type="search" id="catalogoBusqueda" data-global-catalog-search placeholder="Buscar en las tres categorías..."></div></div>
<div class="row g-3 align-items-stretch catalog-columns">
  <div class="col-xl-4 d-flex"><section class="card shadow-sm border-0 w-100 catalog-card"><header class="card-header bg-white d-flex justify-content-between align-items-center"><strong>Activos Genéricos</strong><button type="button" class="btn btn-sm bi-btn-primary" data-catalog-add="generico" data-catalog-label="Activo Genérico" data-bs-toggle="modal" data-bs-target="#catalogoGenericoModal" title="Agregar Activo Genérico" aria-label="Agregar Activo Genérico"><i class="fa-solid fa-plus" aria-hidden="true"></i><span class="visually-hidden">Agregar</span></button></header><ul class="list-group list-group-flush flex-grow-1" data-catalog-list>{% for item in genericos %}<li class="list-group-item catalog-row" data-catalog-row><div class="d-flex justify-content-between gap-2"><div class="min-w-0"><strong>{{ item.nombre|title }}</strong><small class="d-block text-muted">{{ item.descripcion|default('Sin Descripción')|title }}</small></div><span class="badge align-self-start {{ item.activo ? 'text-bg-success' : 'text-bg-secondary' }}">{{ item.activo ? 'Activo' : 'Inactivo' }}</span></div><div class="catalog-row-actions"><button type="button" class="btn btn-sm btn-outline-secondary" data-catalog-edit="generico" data-catalog-label="Activo Genérico" data-id="{{ item.id_activo_generico }}" data-name="{{ item.nombre }}" data-description="{{ item.descripcion|default('') }}" data-bs-toggle="modal" data-bs-target="#catalogoGenericoModal" title="Editar" aria-label="Editar"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i></button><a class="btn btn-sm btn-outline-{{ item.activo ? 'danger' : 'success' }}" href="{{ get_base_url() }}catalogos/cambiar_estado/generico/{{ item.id_activo_generico }}?_t={{ csrf }}" onclick="return confirm('{{ item.activo ? '¿Desactivar este activo genérico?' : '¿Activar este activo genérico?' }}')" title="{{ item.activo ? 'Desactivar' : 'Activar' }}" aria-label="{{ item.activo ? 'Desactivar' : 'Activar' }}"><i class="fa-solid {{ item.activo ? 'fa-toggle-off' : 'fa-toggle-on' }}" aria-hidden="true"></i></a></div></li>{% else %}<li class="list-group-item text-muted" data-catalog-no-records>Sin registros.</li>{% endfor %}<li class="list-group-item text-muted d-none" data-search-empty>Sin coincidencias.</li></ul></section></div>
  <div class="col-xl-4 d-flex"><section class="card shadow-sm border-0 w-100 catalog-card"><header class="card-header bg-white d-flex justify-content-between align-items-center"><strong>Grupos De Activos</strong><button type="button" class="btn btn-sm bi-btn-primary" data-catalog-add="grupo" data-catalog-label="Grupo De Activo" data-bs-toggle="modal" data-bs-target="#catalogoGrupoModal" title="Agregar Grupo De Activo" aria-label="Agregar Grupo De Activo"><i class="fa-solid fa-plus" aria-hidden="true"></i><span class="visually-hidden">Agregar</span></button></header><ul class="list-group list-group-flush flex-grow-1" data-catalog-list>{% for item in grupos %}<li class="list-group-item catalog-row" data-catalog-row><div class="d-flex justify-content-between gap-2"><div class="min-w-0"><strong>{{ item.nombre|title }}</strong><small class="d-block text-muted">{{ item.padre_nombre|title }}{% if item.descripcion %} · {{ item.descripcion|title }}{% endif %}</small></div><span class="badge align-self-start {{ item.activo ? 'text-bg-success' : 'text-bg-secondary' }}">{{ item.activo ? 'Activo' : 'Inactivo' }}</span></div><div class="catalog-row-actions"><button type="button" class="btn btn-sm btn-outline-secondary" data-catalog-edit="grupo" data-catalog-label="Grupo De Activo" data-id="{{ item.id_grupo_activo }}" data-name="{{ item.nombre }}" data-description="{{ item.descripcion|default('') }}" data-parent="{{ item.id_activo_generico }}" data-bs-toggle="modal" data-bs-target="#catalogoGrupoModal" title="Editar" aria-label="Editar"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i></button><a class="btn btn-sm btn-outline-{{ item.activo ? 'danger' : 'success' }}" href="{{ get_base_url() }}catalogos/cambiar_estado/grupo/{{ item.id_grupo_activo }}?_t={{ csrf }}" onclick="return confirm('{{ item.activo ? '¿Desactivar este grupo?' : '¿Activar este grupo?' }}')" title="{{ item.activo ? 'Desactivar' : 'Activar' }}" aria-label="{{ item.activo ? 'Desactivar' : 'Activar' }}"><i class="fa-solid {{ item.activo ? 'fa-toggle-off' : 'fa-toggle-on' }}" aria-hidden="true"></i></a></div></li>{% else %}<li class="list-group-item text-muted" data-catalog-no-records>Sin registros.</li>{% endfor %}<li class="list-group-item text-muted d-none" data-search-empty>Sin coincidencias.</li></ul></section></div>
  <div class="col-xl-4 d-flex"><section class="card shadow-sm border-0 w-100 catalog-card"><header class="card-header bg-white d-flex justify-content-between align-items-center"><strong>Activos Específicos</strong><button type="button" class="btn btn-sm bi-btn-primary" data-catalog-add="especifico" data-catalog-label="Activo Específico" data-bs-toggle="modal" data-bs-target="#catalogoEspecificoModal" title="Agregar Activo Específico" aria-label="Agregar Activo Específico"><i class="fa-solid fa-plus" aria-hidden="true"></i><span class="visually-hidden">Agregar</span></button></header><ul class="list-group list-group-flush flex-grow-1" data-catalog-list>{% for item in especificos %}<li class="list-group-item catalog-row" data-catalog-row><div class="d-flex justify-content-between gap-2"><div class="min-w-0"><strong>{{ item.nombre|title }}</strong><small class="d-block text-muted">{{ item.generico_nombre|title }} · {{ item.padre_nombre|title }}{% if item.descripcion %} · {{ item.descripcion|title }}{% endif %}</small></div><span class="badge align-self-start {{ item.activo ? 'text-bg-success' : 'text-bg-secondary' }}">{{ item.activo ? 'Activo' : 'Inactivo' }}</span></div><div class="catalog-row-actions"><button type="button" class="btn btn-sm btn-outline-secondary" data-catalog-edit="especifico" data-catalog-label="Activo Específico" data-id="{{ item.id_activo_especifico }}" data-name="{{ item.nombre }}" data-description="{{ item.descripcion|default('') }}" data-parent="{{ item.id_grupo_activo }}" data-bs-toggle="modal" data-bs-target="#catalogoEspecificoModal" title="Editar" aria-label="Editar"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i></button><a class="btn btn-sm btn-outline-{{ item.activo ? 'danger' : 'success' }}" href="{{ get_base_url() }}catalogos/cambiar_estado/especifico/{{ item.id_activo_especifico }}?_t={{ csrf }}" onclick="return confirm('{{ item.activo ? '¿Desactivar este activo específico?' : '¿Activar este activo específico?' }}')" title="{{ item.activo ? 'Desactivar' : 'Activar' }}" aria-label="{{ item.activo ? 'Desactivar' : 'Activar' }}"><i class="fa-solid {{ item.activo ? 'fa-toggle-off' : 'fa-toggle-on' }}" aria-hidden="true"></i></a></div></li>{% else %}<li class="list-group-item text-muted" data-catalog-no-records>Sin registros.</li>{% endfor %}<li class="list-group-item text-muted d-none" data-search-empty>Sin coincidencias.</li></ul></section></div>
</div>

<div class="modal fade" id="catalogoGenericoModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><form method="post" action="{{ get_base_url() }}catalogos/guardar/generico" data-catalog-form="generico"><input type="hidden" name="csrf" value="{{ csrf }}"><div class="modal-header"><h2 class="modal-title fs-5" data-catalog-title>Agregar Activo Genérico</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div><div class="modal-body"><label class="form-label">Nombre</label><input class="form-control mb-3" name="nombre" required maxlength="150"><label class="form-label">Descripción</label><textarea class="form-control" name="descripcion" maxlength="250" rows="3"></textarea></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" title="Cancelar" aria-label="Cancelar"><i class="fa-solid fa-xmark" aria-hidden="true"></i><span class="visually-hidden">Cancelar</span></button><button type="submit" class="btn bi-btn-primary" title="Guardar" aria-label="Guardar"><i class="fa-solid fa-floppy-disk me-1" aria-hidden="true"></i><span data-submit-label>Guardar</span></button></div></form></div></div></div>
<div class="modal fade" id="catalogoGrupoModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><form method="post" action="{{ get_base_url() }}catalogos/guardar/grupo" data-catalog-form="grupo"><input type="hidden" name="csrf" value="{{ csrf }}"><div class="modal-header"><h2 class="modal-title fs-5" data-catalog-title>Agregar Grupo De Activo</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div><div class="modal-body"><label class="form-label">Activo Genérico</label><select class="form-select mb-3" name="id_activo_generico" required><option value="">Seleccionar...</option>{% for padre in genericos_para_modal %}<option value="{{ padre.id_activo_generico }}" data-active="{{ padre.activo }}">{{ padre.nombre|title }}{% if not padre.activo %} (Inactivo){% endif %}</option>{% endfor %}</select><label class="form-label">Nombre</label><input class="form-control mb-3" name="nombre" required maxlength="150"><label class="form-label">Descripción</label><textarea class="form-control" name="descripcion" maxlength="250" rows="3"></textarea></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" title="Cancelar" aria-label="Cancelar"><i class="fa-solid fa-xmark" aria-hidden="true"></i><span class="visually-hidden">Cancelar</span></button><button type="submit" class="btn bi-btn-primary" title="Guardar" aria-label="Guardar"><i class="fa-solid fa-floppy-disk me-1" aria-hidden="true"></i><span data-submit-label>Guardar</span></button></div></form></div></div></div>
<div class="modal fade" id="catalogoEspecificoModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><form method="post" action="{{ get_base_url() }}catalogos/guardar/especifico" data-catalog-form="especifico"><input type="hidden" name="csrf" value="{{ csrf }}"><div class="modal-header"><h2 class="modal-title fs-5" data-catalog-title>Agregar Activo Específico</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div><div class="modal-body"><label class="form-label">Grupo De Activo</label><select class="form-select mb-3" name="id_grupo_activo" required><option value="">Seleccionar...</option>{% for padre in grupos_para_modal %}<option value="{{ padre.id_grupo_activo }}" data-active="{{ padre.activo }}">{{ padre.nombre|title }}{% if not padre.activo %} (Inactivo){% endif %}</option>{% endfor %}</select><label class="form-label">Nombre</label><input class="form-control mb-3" name="nombre" required maxlength="150"><label class="form-label">Descripción</label><textarea class="form-control" name="descripcion" maxlength="250" rows="3"></textarea></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" title="Cancelar" aria-label="Cancelar"><i class="fa-solid fa-xmark" aria-hidden="true"></i><span class="visually-hidden">Cancelar</span></button><button type="submit" class="btn bi-btn-primary" title="Guardar" aria-label="Guardar"><i class="fa-solid fa-floppy-disk me-1" aria-hidden="true"></i><span data-submit-label>Guardar</span></button></div></form></div></div></div>
