{% include 'includes/admin/inventory-top.twig' %}
<h1 class="h3 bi-title mb-1">Clasificación de activos</h1><p class="text-muted mb-4">Activo genérico → grupo → activo específico.</p><div class="row g-3"><div class="col-lg-4"><div class="card shadow-sm border-0 h-100"><div class="card-header bg-white"><strong>Activos genéricos</strong></div><div class="card-body border-bottom"><form method="post" action="{{ get_base_url() }}catalogos/guardar/generico"><input type="hidden" name="csrf" value="{{ csrf }}"><input class="form-control form-control-sm mb-2" required name="nombre" placeholder="Nuevo activo genérico"><input class="form-control form-control-sm mb-2" name="descripcion" placeholder="Descripción"><button class="btn btn-sm bi-btn-primary">Agregar</button></form></div><ul class="list-group list-group-flush">{% for item in genericos %}<li class="list-group-item"><strong>{{ item.nombre }}</strong><br><small>{{ item.descripcion|default('') }}</small></li>{% else %}<li class="list-group-item text-muted">Sin registros.</li>{% endfor %}</ul></div></div><div class="col-lg-4"><div class="card shadow-sm border-0 h-100"><div class="card-header bg-white"><strong>Grupos</strong></div><div class="card-body border-bottom"><form method="post" action="{{ get_base_url() }}catalogos/guardar/grupo"><input type="hidden" name="csrf" value="{{ csrf }}"><select class="form-select form-select-sm mb-2" name="id_activo_generico" required><option value="">Activo genérico...</option>{% for item in genericos %}<option value="{{ item.id_activo_generico }}">{{ item.nombre }}</option>{% endfor %}</select><input class="form-control form-control-sm mb-2" required name="nombre" placeholder="Nuevo grupo"><button class="btn btn-sm bi-btn-primary">Agregar</button></form></div><ul class="list-group list-group-flush">{% for item in grupos %}<li class="list-group-item">{{ item.nombre }}</li>{% else %}<li class="list-group-item text-muted">Sin registros.</li>{% endfor %}</ul></div></div><div class="col-lg-4"><div class="card shadow-sm border-0 h-100"><div class="card-header bg-white"><strong>Activos específicos</strong></div><div class="card-body border-bottom"><form method="post" action="{{ get_base_url() }}catalogos/guardar/especifico"><input type="hidden" name="csrf" value="{{ csrf }}"><select class="form-select form-select-sm mb-2" name="id_grupo_activo" required><option value="">Grupo...</option>{% for item in grupos %}<option value="{{ item.id_grupo_activo }}">{{ item.nombre }}</option>{% endfor %}</select><input class="form-control form-control-sm mb-2" required name="nombre" placeholder="Nuevo activo específico"><button class="btn btn-sm bi-btn-primary">Agregar</button></form></div><ul class="list-group list-group-flush">{% for item in especificos %}<li class="list-group-item">{{ item.nombre }}</li>{% else %}<li class="list-group-item text-muted">Sin registros.</li>{% endfor %}</ul></div></div></div>
{% include 'includes/admin/inventory-bottom.twig' %}
