{% include 'includes/admin/inventory-top.twig' %}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><h1 class="h3 bi-title mb-1">Clasificación de activos</h1><p class="text-muted mb-0">Activos genéricos, grupos y activos específicos.</p></div><div class="d-flex flex-wrap gap-2 align-items-end"><div class="catalog-global-search"><label class="visually-hidden" for="catalogoBusqueda">Buscar en clasificación</label><input class="form-control" type="search" id="catalogoBusqueda" data-global-catalog-search data-catalog-tree-search placeholder="Buscar por nombre…" autocomplete="off"></div>{% if can_manage_catalogs|default(false) %}<button type="button" class="btn bi-btn-primary" data-catalog-add="generico" data-catalog-label="Activo genérico" data-bs-toggle="modal" data-bs-target="#catalogoGenericoModal"><i class="fa-solid fa-plus me-1" aria-hidden="true"></i>Nuevo activo genérico</button>{% endif %}</div></div>
<section class="card shadow-sm border-0 catalog-tree-card" aria-label="Árbol de clasificación de activos"><div class="table-responsive"><table class="table table-hover align-middle mb-0 catalog-tree" data-catalog-tree><thead><tr><th scope="col">Clasificación</th><th scope="col">Nivel</th><th scope="col">Estado</th><th scope="col" class="text-end">Acciones</th></tr></thead><tbody>
{% for generico in clasificacion_tree %}
{% set genericoNodeId = 'generico-' ~ generico.id_activo_generico %}
<tr data-tree-row data-tree-id="{{ genericoNodeId }}" data-tree-level="generico"><th scope="row"><div class="catalog-tree-node catalog-tree-node--generic"><button type="button" class="catalog-tree-toggle" data-tree-toggle="{{ genericoNodeId }}" aria-expanded="false" aria-label="Mostrar grupos de {{ generico.nombre }}"><span aria-hidden="true">▶</span></button><span class="catalog-tree-label" data-tree-search-text><strong>{{ generico.nombre|title }}</strong>{% if generico.descripcion %}<small>{{ generico.descripcion|title }}</small>{% endif %}</span></div></th><td>Activo genérico</td><td><span class="badge {{ generico.activo ? 'text-bg-success' : 'text-bg-secondary' }}">{{ generico.activo ? 'Activo' : 'Inactivo' }}</span></td><td class="text-end text-nowrap"><div class="catalog-tree-actions">{% if can_manage_catalogs|default(false) %}{% if generico.activo %}<button type="button" class="btn btn-sm btn-outline-primary" data-catalog-add="grupo" data-catalog-label="Grupo de activo" data-parent="{{ generico.id_activo_generico }}" data-bs-toggle="modal" data-bs-target="#catalogoGrupoModal" aria-label="Agregar grupo a {{ generico.nombre }}" title="Agregar grupo"><i class="fa-solid fa-folder-plus" aria-hidden="true"></i></button>{% endif %}<button type="button" class="btn btn-sm btn-outline-secondary" data-catalog-edit="generico" data-catalog-label="Activo genérico" data-id="{{ generico.id_activo_generico }}" data-name="{{ generico.nombre }}" data-description="{{ generico.descripcion|default('') }}" data-bs-toggle="modal" data-bs-target="#catalogoGenericoModal" aria-label="Editar {{ generico.nombre }}" title="Editar"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i></button>{% endif %}{% if can_inactivate_catalogs|default(false) %}<a class="btn btn-sm btn-outline-{{ generico.activo ? 'danger' : 'success' }}" href="{{ get_base_url() }}catalogos/cambiar_estado/generico/{{ generico.id_activo_generico }}?_t={{ csrf }}" onclick="return confirm('{{ generico.activo ? '¿Desactivar este activo genérico?' : '¿Activar este activo genérico?' }}')" aria-label="{{ generico.activo ? 'Desactivar' : 'Activar' }} {{ generico.nombre }}" title="{{ generico.activo ? 'Desactivar' : 'Activar' }}"><i class="fa-solid {{ generico.activo ? 'fa-toggle-off' : 'fa-toggle-on' }}" aria-hidden="true"></i></a>{% endif %}</div></td></tr>
{% for grupo in generico.grupos %}
{% set grupoNodeId = 'grupo-' ~ grupo.id_grupo_activo %}
<tr data-tree-row data-tree-id="{{ grupoNodeId }}" data-tree-parent="{{ genericoNodeId }}" data-tree-level="grupo" hidden><th scope="row"><div class="catalog-tree-node catalog-tree-node--group"><button type="button" class="catalog-tree-toggle" data-tree-toggle="{{ grupoNodeId }}" aria-expanded="false" aria-label="Mostrar activos específicos de {{ grupo.nombre }}"><span aria-hidden="true">▶</span></button><span class="catalog-tree-branch" aria-hidden="true">└</span><span class="catalog-tree-label" data-tree-search-text><strong>{{ grupo.nombre|title }}</strong>{% if grupo.descripcion %}<small>{{ grupo.descripcion|title }}</small>{% endif %}</span></div></th><td>Grupo</td><td><span class="badge {{ grupo.activo ? 'text-bg-success' : 'text-bg-secondary' }}">{{ grupo.activo ? 'Activo' : 'Inactivo' }}</span></td><td class="text-end text-nowrap"><div class="catalog-tree-actions">{% if can_manage_catalogs|default(false) %}{% if grupo.activo %}<button type="button" class="btn btn-sm btn-outline-primary" data-catalog-add="especifico" data-catalog-label="Activo específico" data-parent="{{ grupo.id_grupo_activo }}" data-bs-toggle="modal" data-bs-target="#catalogoEspecificoModal" aria-label="Agregar activo específico a {{ grupo.nombre }}" title="Agregar activo específico"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>{% endif %}<button type="button" class="btn btn-sm btn-outline-secondary" data-catalog-edit="grupo" data-catalog-label="Grupo de activo" data-id="{{ grupo.id_grupo_activo }}" data-name="{{ grupo.nombre }}" data-description="{{ grupo.descripcion|default('') }}" data-parent="{{ grupo.id_activo_generico }}" data-bs-toggle="modal" data-bs-target="#catalogoGrupoModal" aria-label="Editar {{ grupo.nombre }}" title="Editar"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i></button>{% endif %}{% if can_inactivate_catalogs|default(false) %}<a class="btn btn-sm btn-outline-{{ grupo.activo ? 'danger' : 'success' }}" href="{{ get_base_url() }}catalogos/cambiar_estado/grupo/{{ grupo.id_grupo_activo }}?_t={{ csrf }}" onclick="return confirm('{{ grupo.activo ? '¿Desactivar este grupo?' : '¿Activar este grupo?' }}')" aria-label="{{ grupo.activo ? 'Desactivar' : 'Activar' }} {{ grupo.nombre }}" title="{{ grupo.activo ? 'Desactivar' : 'Activar' }}"><i class="fa-solid {{ grupo.activo ? 'fa-toggle-off' : 'fa-toggle-on' }}" aria-hidden="true"></i></a>{% endif %}</div></td></tr>
{% for especifico in grupo.activos_especificos %}
{% set especificoNodeId = 'especifico-' ~ especifico.id_activo_especifico %}
<tr data-tree-row data-tree-id="{{ especificoNodeId }}" data-tree-parent="{{ grupoNodeId }}" data-tree-level="especifico" hidden><th scope="row"><div class="catalog-tree-node catalog-tree-node--specific"><span class="catalog-tree-spacer" aria-hidden="true"></span><span class="catalog-tree-branch" aria-hidden="true">└</span><span class="catalog-tree-label" data-tree-search-text><strong>{{ especifico.nombre|title }}</strong>{% if especifico.descripcion %}<small>{{ especifico.descripcion|title }}</small>{% endif %}</span></div></th><td>Activo específico</td><td><span class="badge {{ especifico.activo ? 'text-bg-success' : 'text-bg-secondary' }}">{{ especifico.activo ? 'Activo' : 'Inactivo' }}</span></td><td class="text-end text-nowrap"><div class="catalog-tree-actions">{% if can_manage_catalogs|default(false) %}<button type="button" class="btn btn-sm btn-outline-secondary" data-catalog-edit="especifico" data-catalog-label="Activo específico" data-id="{{ especifico.id_activo_especifico }}" data-name="{{ especifico.nombre }}" data-description="{{ especifico.descripcion|default('') }}" data-parent="{{ especifico.id_grupo_activo }}" data-bs-toggle="modal" data-bs-target="#catalogoEspecificoModal" aria-label="Editar {{ especifico.nombre }}" title="Editar"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i></button>{% endif %}{% if can_inactivate_catalogs|default(false) %}<a class="btn btn-sm btn-outline-{{ especifico.activo ? 'danger' : 'success' }}" href="{{ get_base_url() }}catalogos/cambiar_estado/especifico/{{ especifico.id_activo_especifico }}?_t={{ csrf }}" onclick="return confirm('{{ especifico.activo ? '¿Desactivar este activo específico?' : '¿Activar este activo específico?' }}')" aria-label="{{ especifico.activo ? 'Desactivar' : 'Activar' }} {{ especifico.nombre }}" title="{{ especifico.activo ? 'Desactivar' : 'Activar' }}"><i class="fa-solid {{ especifico.activo ? 'fa-toggle-off' : 'fa-toggle-on' }}" aria-hidden="true"></i></a>{% endif %}</div></td></tr>
{% endfor %}{% endfor %}{% else %}
<tr data-tree-empty><td colspan="4" class="text-center py-5 text-muted">No hay activos genéricos registrados.</td></tr>
{% endfor %}
<tr data-tree-search-empty hidden><td colspan="4" class="text-center py-5 text-muted">No se encontraron coincidencias.</td></tr>
</tbody></table></div></section>

<div class="modal fade" id="catalogoGenericoModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><form method="post" action="{{ get_base_url() }}catalogos/guardar/generico" data-catalog-form="generico"><input type="hidden" name="csrf" value="{{ csrf }}"><div class="modal-header"><h2 class="modal-title fs-5" data-catalog-title>Agregar Activo Genérico</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div><div class="modal-body"><label class="form-label">Nombre</label><input class="form-control mb-3" name="nombre" required maxlength="150"><label class="form-label">Descripción</label><textarea class="form-control" name="descripcion" maxlength="250" rows="3"></textarea></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" title="Cancelar" aria-label="Cancelar"><i class="fa-solid fa-xmark" aria-hidden="true"></i><span class="visually-hidden">Cancelar</span></button><button type="submit" class="btn bi-btn-primary" title="Guardar" aria-label="Guardar"><i class="fa-solid fa-floppy-disk me-1" aria-hidden="true"></i><span data-submit-label>Guardar</span></button></div></form></div></div></div>
<div class="modal fade" id="catalogoGrupoModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><form method="post" action="{{ get_base_url() }}catalogos/guardar/grupo" data-catalog-form="grupo"><input type="hidden" name="csrf" value="{{ csrf }}"><div class="modal-header"><h2 class="modal-title fs-5" data-catalog-title>Agregar Grupo De Activo</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div><div class="modal-body"><label class="form-label">Activo Genérico</label><select class="form-select mb-3" name="id_activo_generico" required><option value="">Seleccionar...</option>{% for padre in genericos_para_modal %}<option value="{{ padre.id_activo_generico }}" data-active="{{ padre.activo }}">{{ padre.nombre|title }}{% if not padre.activo %} (Inactivo){% endif %}</option>{% endfor %}</select><label class="form-label">Nombre</label><input class="form-control mb-3" name="nombre" required maxlength="150"><label class="form-label">Descripción</label><textarea class="form-control" name="descripcion" maxlength="250" rows="3"></textarea></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" title="Cancelar" aria-label="Cancelar"><i class="fa-solid fa-xmark" aria-hidden="true"></i><span class="visually-hidden">Cancelar</span></button><button type="submit" class="btn bi-btn-primary" title="Guardar" aria-label="Guardar"><i class="fa-solid fa-floppy-disk me-1" aria-hidden="true"></i><span data-submit-label>Guardar</span></button></div></form></div></div></div>
<div class="modal fade" id="catalogoEspecificoModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><form method="post" action="{{ get_base_url() }}catalogos/guardar/especifico" data-catalog-form="especifico"><input type="hidden" name="csrf" value="{{ csrf }}"><div class="modal-header"><h2 class="modal-title fs-5" data-catalog-title>Agregar Activo Específico</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div><div class="modal-body"><label class="form-label">Grupo De Activo</label><select class="form-select mb-3" name="id_grupo_activo" required><option value="">Seleccionar...</option>{% for padre in grupos_para_modal %}<option value="{{ padre.id_grupo_activo }}" data-active="{{ padre.activo }}">{{ padre.nombre|title }}{% if not padre.activo %} (Inactivo){% endif %}</option>{% endfor %}</select><label class="form-label">Nombre</label><input class="form-control mb-3" name="nombre" required maxlength="150"><label class="form-label">Descripción</label><textarea class="form-control" name="descripcion" maxlength="250" rows="3"></textarea></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" title="Cancelar" aria-label="Cancelar"><i class="fa-solid fa-xmark" aria-hidden="true"></i><span class="visually-hidden">Cancelar</span></button><button type="submit" class="btn bi-btn-primary" title="Guardar" aria-label="Guardar"><i class="fa-solid fa-floppy-disk me-1" aria-hidden="true"></i><span data-submit-label>Guardar</span></button></div></form></div></div></div>
<script>
(() => {
  const table = document.querySelector('[data-catalog-tree]');
  if (!table) return;
  const search = document.querySelector('[data-catalog-tree-search]');
  const rows = [...table.querySelectorAll('[data-tree-row]')];
  const rowsById = new Map(rows.map(row => [row.dataset.treeId, row]));
  const childrenById = new Map();
  const expanded = new Set();
  rows.forEach(row => {
    const parentId = row.dataset.treeParent;
    if (!parentId) return;
    if (!childrenById.has(parentId)) childrenById.set(parentId, []);
    childrenById.get(parentId).push(row);
  });
  table.querySelectorAll('[data-tree-toggle]').forEach(button => {
    if (!childrenById.has(button.dataset.treeToggle)) button.hidden = true;
    button.addEventListener('click', () => {
      const nodeId = button.dataset.treeToggle;
      if (expanded.has(nodeId)) expanded.delete(nodeId); else expanded.add(nodeId);
      applyTree();
    });
  });

  const applyTree = () => {
    const term = (search?.value || '').trim().normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase();
    const matchingRows = term ? rows.filter(row => (row.querySelector('[data-tree-search-text]')?.textContent || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase().includes(term)) : [];
    const needed = new Set(matchingRows);
    matchingRows.forEach(row => {
      let parentId = row.dataset.treeParent;
      while (parentId) {
        const parent = rowsById.get(parentId);
        if (!parent) break;
        needed.add(parent);
        expanded.add(parent.dataset.treeId);
        parentId = parent.dataset.treeParent;
      }
    });
    rows.forEach(row => {
      const parentId = row.dataset.treeParent;
      const parentVisible = !parentId || (() => {
        const parent = rowsById.get(parentId);
        return !!parent && !parent.hidden && (term ? needed.has(parent) : expanded.has(parentId));
      })();
      row.hidden = term ? !needed.has(row) || !parentVisible : !parentVisible;
      const toggle = row.querySelector('[data-tree-toggle]');
      if (toggle) {
        const isExpanded = expanded.has(row.dataset.treeId);
        toggle.setAttribute('aria-expanded', String(isExpanded));
        toggle.setAttribute('aria-label', `${isExpanded ? 'Ocultar' : 'Mostrar'} ${row.dataset.treeLevel === 'generico' ? 'grupos' : 'activos específicos'} de ${row.querySelector('[data-tree-search-text]')?.querySelector('strong')?.textContent || ''}`);
        const arrow = toggle.querySelector('[aria-hidden="true"]');
        if (arrow) arrow.textContent = isExpanded ? '▼' : '▶';
      }
    });
    const noGenerics = table.querySelector('[data-tree-empty]');
    if (noGenerics) noGenerics.hidden = !!term;
    const empty = table.querySelector('[data-tree-search-empty]');
    if (empty) empty.hidden = !term || matchingRows.length > 0;
  };
  search?.addEventListener('input', applyTree);
  applyTree();
})();
</script>
{% include 'includes/admin/inventory-bottom.twig' %}
