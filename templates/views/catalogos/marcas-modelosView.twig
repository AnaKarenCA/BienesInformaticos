{% include 'includes/admin/inventory-top.twig' %}
<h1 class="h3 bi-title mb-4">Marcas y modelos</h1>
<div class="row g-3">
  <div class="col-md-5"><div class="card shadow-sm border-0"><div class="card-header bg-white"><strong>Marcas</strong></div><div class="card-body border-bottom"><form method="post" action="{{ get_base_url() }}catalogos/guardar/marca"><input type="hidden" name="csrf" value="{{ csrf }}"><div class="input-group"><input class="form-control" required name="nombre" placeholder="Nueva marca"><button class="btn bi-btn-primary">Agregar</button></div></form></div><ul class="list-group list-group-flush">{% for item in marcas %}<li class="list-group-item">{{ item.nombre }}</li>{% else %}<li class="list-group-item text-muted">Sin registros.</li>{% endfor %}</ul></div></div>
  <div class="col-md-7"><div class="card shadow-sm border-0"><div class="card-header bg-white"><strong>Modelos</strong></div><div class="card-body border-bottom"><form class="row g-2" method="post" action="{{ get_base_url() }}catalogos/guardar/modelo"><input type="hidden" name="csrf" value="{{ csrf }}"><div class="col"><select class="form-select" name="id_marca" required><option value="">Marca...</option>{% for marca in marcas %}<option value="{{ marca.id_marca }}">{{ marca.nombre }}</option>{% endfor %}</select></div><div class="col"><input class="form-control" name="nombre" required placeholder="Nuevo modelo"></div><div class="col-auto"><button class="btn bi-btn-primary">Agregar</button></div></form></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Modelo</th><th>Marca</th></tr></thead><tbody>{% for item in modelos %}<tr><td>{{ item.nombre }}</td><td>{% for marca in marcas %}{% if marca.id_marca == item.id_marca %}{{ marca.nombre }}{% endif %}{% endfor %}</td></tr>{% else %}<tr><td colspan="2" class="text-muted text-center">Sin registros.</td></tr>{% endfor %}</tbody></table></div></div></div>
</div>
{% include 'includes/admin/inventory-bottom.twig' %}
