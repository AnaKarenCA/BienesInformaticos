{% include 'includes/admin/inventory-top.twig' %}
<h1 class="h3 bi-title mb-4">Ubicaciones</h1><div class="card shadow-sm border-0"><div class="card-body border-bottom"><form class="row g-2" method="post" action="{{ get_base_url() }}catalogos/guardar/ubicacion"><input type="hidden" name="csrf" value="{{ csrf }}"><div class="col-md-3"><input class="form-control" name="municipio" required placeholder="Municipio"></div><div class="col-md-3"><input class="form-control" name="localidad" required placeholder="Localidad"></div><div class="col-md-4"><input class="form-control" name="ubicacion_fisica" placeholder="Piso, sección o cubículo"></div><div class="col-md-2"><button class="btn bi-btn-primary w-100">Agregar</button></div></form></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Municipio</th><th>Localidad</th><th>Ubicación física</th><th>Estado</th></tr></thead><tbody>{% for item in ubicaciones %}<tr><td>{{ item.municipio }}</td><td>{{ item.localidad }}</td><td>{{ item.ubicacion_fisica|default('—') }}</td><td><span class="badge text-bg-success">Activa</span></td></tr>{% else %}<tr><td colspan="4" class="text-center text-muted">Sin registros.</td></tr>{% endfor %}</tbody></table></div></div>
{% include 'includes/admin/inventory-bottom.twig' %}
