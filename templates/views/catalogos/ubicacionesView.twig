{% include 'includes/admin/inventory-top.twig' %}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
  <div><h1 class="h3 bi-title mb-1">Ubicaciones</h1><p class="text-muted mb-0">Administra municipios y localidades disponibles para los bienes.</p></div>
  <div class="d-flex flex-wrap gap-2"><input class="form-control" style="width:min(100%,340px)" type="search" data-global-catalog-search placeholder="Buscar municipio o localidad..." aria-label="Buscar ubicaciones"><button type="button" class="btn bi-btn-primary" data-catalog-add="ubicacion" data-catalog-label="ubicación" data-bs-toggle="modal" data-bs-target="#ubicacionModal"><i class="fa-solid fa-plus me-1"></i>Agregar ubicación</button></div>
</div>
<section class="card shadow-sm border-0"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Municipio</th><th>Localidad</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead><tbody data-catalog-table>
{% for item in ubicaciones %}<tr data-catalog-row><td class="fw-semibold">{{ item.municipio }}</td><td>{{ item.localidad }}</td><td><span class="badge {{ item.activo ? 'text-bg-success' : 'text-bg-secondary' }}">{{ item.activo ? 'Activa' : 'Inactiva' }}</span></td><td class="text-end text-nowrap"><button type="button" class="btn btn-sm btn-outline-secondary" data-catalog-edit="ubicacion" data-catalog-label="ubicación" data-id="{{ item.id_ubicacion }}" data-municipio="{{ item.municipio }}" data-localidad="{{ item.localidad }}" data-bs-toggle="modal" data-bs-target="#ubicacionModal" title="Editar ubicación"><i class="fa-solid fa-pen-to-square me-1"></i>Editar</button> <a class="btn btn-sm btn-outline-{{ item.activo ? 'danger' : 'success' }}" href="{{ get_base_url() }}catalogos/cambiar_estado/ubicacion/{{ item.id_ubicacion }}?_t={{ csrf }}" onclick="return confirm('{{ item.activo ? '¿Desactivar esta ubicación?' : '¿Activar esta ubicación?' }}')"><i class="fa-solid {{ item.activo ? 'fa-toggle-off' : 'fa-toggle-on' }} me-1"></i>{{ item.activo ? 'Desactivar' : 'Activar' }}</a></td></tr>
{% else %}<tr data-catalog-no-records><td colspan="4" class="text-center text-muted py-4">Sin registros.</td></tr>{% endfor %}<tr class="d-none" data-search-empty><td colspan="4" class="text-center text-muted py-4">Sin coincidencias.</td></tr>
</tbody></table></div></section>
<div class="modal fade" id="ubicacionModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><form method="post" action="{{ get_base_url() }}catalogos/guardar/ubicacion" data-catalog-form="ubicacion"><input type="hidden" name="csrf" value="{{ csrf }}"><div class="modal-header"><h2 class="modal-title fs-5" data-catalog-title>Agregar ubicación</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div><div class="modal-body"><label class="form-label" for="ubicacionMunicipio">Municipio</label><input class="form-control mb-3" id="ubicacionMunicipio" name="municipio" required maxlength="100"><label class="form-label" for="ubicacionLocalidad">Localidad</label><input class="form-control" id="ubicacionLocalidad" name="localidad" required maxlength="100"></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button><button type="submit" class="btn bi-btn-primary"><i class="fa-solid fa-floppy-disk me-1"></i><span data-submit-label>Guardar</span></button></div></form></div></div></div>
{% include 'includes/admin/inventory-bottom.twig' %}
