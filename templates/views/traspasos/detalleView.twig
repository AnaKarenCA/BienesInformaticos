{% include 'includes/admin/inventory-top.twig' %}
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4"><div><a class="small text-muted" href="{{ get_base_url() }}traspasos"><i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>Volver a traspasos</a><h1 class="h3 bi-title mt-2 mb-1">Expediente {{ traspaso.folio }}</h1><p class="text-muted mb-0">{{ traspaso.tipo == 'ENTRE_UNIDADES' ? 'Traspaso entre unidades administrativas' : 'Traspaso dentro de la misma unidad' }}</p></div><span class="badge fs-6 text-bg-light">{{ traspaso.estado|replace({'_':' '})|title }}</span></div>
<section class="card border-0 shadow-sm mb-4"><div class="card-body"><h2 class="h6">Progreso del expediente</h2><ol class="d-flex flex-wrap gap-4 ps-3 mb-0" aria-label="Etapas del traspaso"><li class="{{ traspaso.estado in ['CREADO','PENDIENTE_AUTORIZACION','AUTORIZADO','PENDIENTE_ENTREGA','ENTREGA_CONFIRMADA','PENDIENTE_RECEPCION','DOCUMENTOS','FIRMA','COMPLETADO'] ? 'text-danger fw-semibold' : 'text-muted' }}">Creado</li><li class="{{ traspaso.tipo == 'MISMA_UNIDAD' ? 'text-muted' : (traspaso.estado in ['PENDIENTE_AUTORIZACION','AUTORIZADO','DOCUMENTOS','FIRMA','COMPLETADO'] ? 'text-danger fw-semibold' : 'text-muted') }}">Autorización {{ traspaso.tipo == 'MISMA_UNIDAD' ? '(no requerida)' : '' }}</li><li class="{{ traspaso.estado in ['DOCUMENTOS','FIRMA','COMPLETADO'] ? 'text-danger fw-semibold' : 'text-muted' }}">Documentos</li><li class="{{ traspaso.estado in ['FIRMA','COMPLETADO'] ? 'text-danger fw-semibold' : 'text-muted' }}">Evidencia firmada</li><li class="{{ traspaso.estado == 'COMPLETADO' ? 'text-danger fw-semibold' : 'text-muted' }}">Completado</li></ol>{% if traspaso.estado in ['RECHAZADO','CANCELADO'] %}<p class="mt-3 mb-0 text-danger">Expediente {{ traspaso.estado|lower }}. Los bienes conservan su custodia actual.</p>{% endif %}</div></section>
<div class="row g-4"><div class="col-xl-8">
<section class="card border-0 shadow-sm mb-4"><div class="card-header bg-white"><h2 class="h5 mb-0">Información del expediente</h2></div><div class="card-body"><div class="row g-3"><div class="col-md-6"><small class="text-muted d-block">Unidad de origen</small><strong>{{ traspaso.unidad_origen_nombre }}</strong><small class="d-block text-muted">{{ traspaso.unidad_origen_codigo|default('Sin código oficial') }}</small></div><div class="col-md-6"><small class="text-muted d-block">Unidad de destino</small><strong>{{ traspaso.unidad_destino_nombre }}</strong><small class="d-block text-muted">{{ traspaso.unidad_destino_codigo|default('Sin código oficial') }}</small></div><div class="col-md-6"><small class="text-muted d-block">Nuevo resguardante</small><strong>{{ traspaso.resguardante_destino_nombre }}</strong><small class="d-block text-muted">{{ traspaso.resguardante_destino_csp }}</small></div><div class="col-md-6"><small class="text-muted d-block">Creado por</small>{{ traspaso.creador_username|default('Usuario no disponible') }} · {{ traspaso.fecha_creacion|date('d/m/Y H:i') }}</div><div class="col-12"><small class="text-muted d-block">Motivo</small>{{ traspaso.motivo|default('—') }}</div><div class="col-12"><small class="text-muted d-block">Observaciones</small>{{ traspaso.observaciones|default('—') }}</div></div>
{% if traspaso.estado == 'CREADO' and transfer_permissions.modificar %}<hr><form method="post" action="{{ get_base_url() }}traspasos/editar/{{ traspaso.id_traspaso }}" class="row g-2"><input type="hidden" name="csrf" value="{{ csrf }}"><div class="col-md-5"><label class="form-label" for="editReason">Editar motivo</label><input class="form-control" id="editReason" name="motivo" maxlength="250" value="{{ traspaso.motivo }}"></div><div class="col-md-5"><label class="form-label" for="editNotes">Editar observaciones</label><input class="form-control" id="editNotes" name="observaciones" maxlength="1000" value="{{ traspaso.observaciones }}"></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-outline-primary w-100" type="submit">Guardar</button></div></form>{% endif %}
</div></section>
<section class="card border-0 shadow-sm mb-4"><div class="card-header bg-white d-flex justify-content-between"><h2 class="h5 mb-0">Bienes incluidos</h2><span class="badge text-bg-light">{{ traspaso.bienes|length }}</span></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>CI / Inventario</th><th>Bien</th><th>Resguardante anterior</th><th>Ubicación destino</th></tr></thead><tbody>{% for item in traspaso.bienes %}<tr><td>{{ item.clave_interna }}<small class="d-block text-muted">{{ item.numero_inventario|default('') }}</small></td><td>{{ item.nombre_bien }}<small class="d-block text-muted">{{ item.numero_serie|default('') }}</small></td><td>{{ item.resguardante_origen_nombre }}<small class="d-block text-muted">{{ item.resguardante_origen_csp }}</small></td><td>{% if item.ubicacion_sin_cambio %}Sin cambio{% else %}{{ item.municipio_destino|default('') }} — {{ item.localidad_destino|default('') }}{% endif %}</td></tr>{% endfor %}</tbody></table></div></section>
<section class="card border-0 shadow-sm mb-4"><div class="card-header bg-white"><h2 class="h5 mb-0">Oficio y documentos del expediente</h2></div><div class="card-body">
{% if traspaso.tipo == 'ENTRE_UNIDADES' and transfer_permissions.subir_documento and traspaso.estado == 'PENDIENTE_AUTORIZACION' %}<form method="post" enctype="multipart/form-data" action="{{ get_base_url() }}traspasos/subir-documento/{{ traspaso.id_traspaso }}" class="row g-2 align-items-end mb-3"><input type="hidden" name="csrf" value="{{ csrf }}"><div class="col-md-4"><label class="form-label" for="transferOfficeNumber">Número de oficio</label><input class="form-control" id="transferOfficeNumber" name="numero_oficio" maxlength="100" required></div><div class="col-md-3"><label class="form-label" for="transferOfficeDate">Fecha del oficio</label><input class="form-control" type="date" id="transferOfficeDate" name="fecha_oficio" required></div><div class="col-md-5"><label class="form-label" for="transferOffice">Reemplazar oficio (solo PDF, máx. 15 MB)</label><input class="form-control" type="file" id="transferOffice" name="oficio" accept=".pdf,application/pdf" required></div><div class="col-12"><button class="btn btn-outline-primary" type="submit">Cargar nueva versión del oficio</button></div></form>{% endif %}
{% for doc in traspaso.documentos %}{% if doc.tipo_documento == 'OFICIO_AUTORIZACION' %}<div class="border rounded p-3 mb-3"><strong>Oficio de autorización</strong><small class="d-block text-muted">{{ doc.nombre_original }} · {{ doc.metadata.numero_oficio|default('Número no capturado') }} · {{ doc.metadata.fecha_oficio|default('Fecha no capturada') }} · {{ doc.fecha_carga|date('d/m/Y H:i') }}</small><div class="d-flex flex-wrap gap-2 mt-2">{% if transfer_permissions['descargar-documentos'] %}<a class="btn btn-sm btn-outline-primary" href="{{ get_base_url() }}traspasos/ver-documento/{{ doc.id_traspaso_documento }}" target="_blank" rel="noopener">Ver oficio</a><a class="btn btn-sm btn-outline-secondary" href="{{ get_base_url() }}traspasos/descargar-documento/{{ doc.id_traspaso_documento }}">Descargar</a>{% endif %}</div></div>{% endif %}{% endfor %}
{% for doc in traspaso.documentos %}{% if doc.tipo_documento in ['TARJETA_RESGUARDO','RESGUARDO_EQUIPO'] and not doc.id_bien %}<div class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2"><div><strong>Documento histórico sin asociación por bien · {{ doc.tipo_documento|replace({'_':' '})|title }}</strong><small class="d-block text-muted">{{ doc.nombre_original }} · {{ doc.fecha_carga|date('d/m/Y H:i') }}</small></div>{% if transfer_permissions['descargar-documentos'] %}<a class="btn btn-sm btn-outline-secondary" href="{{ get_base_url() }}traspasos/descargar-documento/{{ doc.id_traspaso_documento }}">Descargar</a>{% endif %}</div>{% endif %}{% endfor %}
{% if traspaso.puede_editar_datos_documento and transfer_permissions.modificar %}<form method="post" action="{{ get_base_url() }}traspasos/editar-datos-documentos/{{ traspaso.id_traspaso }}" class="row g-2 border rounded p-3 mb-4"><input type="hidden" name="csrf" value="{{ csrf }}"><div class="col-12"><h3 class="h6">Datos para los documentos</h3><p class="small text-muted mb-1">Puedes corregir estos datos antes de cargar evidencia documental firmada. Si ya se generaron documentos, se conservarán como versiones previas y tendrás que generar versiones nuevas.</p></div><div class="col-md-5"><label class="form-label" for="documentTransferReason">Motivo</label><input class="form-control" id="documentTransferReason" name="motivo" maxlength="250" value="{{ traspaso.motivo }}"></div><div class="col-md-7"><label class="form-label" for="documentTransferNotes">Observaciones</label><input class="form-control" id="documentTransferNotes" name="observaciones" maxlength="1000" value="{{ traspaso.observaciones }}"></div><div class="col-12"><button class="btn btn-outline-secondary btn-sm" type="submit">Guardar datos del documento</button></div></form>{% endif %}
<h3 class="h6">Documentos obligatorios por bien</h3><p class="small text-muted">Genera, imprime y firma físicamente los documentos. Después carga la digitalización firmada como evidencia documental; el sistema no registra ni representa firmas digitales.</p>
<p class="small text-muted">Baja de resguardante: no corresponde en este flujo. El traspaso no genera una baja automáticamente.</p>
{% for doc in traspaso.documentos %}{% if doc.obsoleto and doc.id_bien %}<div class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2"><div><strong>Versión previa · {{ doc.tipo_documento|replace({'_':' '})|title }}</strong><small class="d-block text-muted">{{ doc.bien_label }} · {{ doc.nombre_original }} · {{ doc.fecha_carga|date('d/m/Y H:i') }}</small></div>{% if transfer_permissions['descargar-documentos'] %}<a class="btn btn-sm btn-outline-secondary" href="{{ get_base_url() }}traspasos/descargar-documento/{{ doc.id_traspaso_documento }}">Descargar versión previa</a>{% endif %}</div>{% endif %}{% endfor %}
{% for doc in traspaso.documentos_vigentes %}<div class="list-group-item border rounded mb-2"><div class="d-flex flex-wrap justify-content-between gap-2"><div><strong>{{ doc.tipo_documento == 'TARJETA_RESGUARDO' ? 'Tarjeta de Resguardo' : 'Resguardo del Equipo' }}</strong><small class="d-block text-muted">{{ doc.nombre_original }} · {{ doc.fecha_carga|date('d/m/Y H:i') }} · {{ doc.bien_label }}</small></div>{% if transfer_permissions['descargar-documentos'] %}<div class="d-flex gap-2"><a class="btn btn-sm btn-outline-primary" href="{{ get_base_url() }}traspasos/ver-documento/{{ doc.id_traspaso_documento }}" target="_blank" rel="noopener">Ver documento</a><a class="btn btn-sm btn-outline-secondary" href="{{ get_base_url() }}traspasos/descargar-documento/{{ doc.id_traspaso_documento }}">Descargar</a></div>{% endif %}</div>
<div class="mt-2">{% include 'includes/components/status-badge.twig' with { active: doc.evidencia_firmada, active_label: 'Evidencia documental firmada cargada', inactive_label: 'Generado · pendiente de evidencia documental firmada' } only %}</div>
{% if traspaso.estado == 'FIRMA' and transfer_permissions['subir-documento'] %}<form method="post" enctype="multipart/form-data" action="{{ get_base_url() }}traspasos/subir-documento-firmado/{{ traspaso.id_traspaso }}" class="row g-2 mt-2"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="documento_origen" value="{{ doc.id_traspaso_documento }}"><div class="col-md"><label class="visually-hidden" for="signedDocument{{ doc.id_traspaso_documento }}">Documento firmado</label><input class="form-control form-control-sm" id="signedDocument{{ doc.id_traspaso_documento }}" type="file" name="documento_firmado" accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png" required></div><div class="col-md-auto"><button class="btn btn-sm btn-outline-primary" type="submit">{{ doc.evidencia_firmada ? 'Cargar nueva versión firmada' : 'Cargar documento firmado' }}</button></div></form>{% endif %}</div>{% else %}<p class="text-muted">Aún no se han generado los documentos obligatorios.</p>{% endfor %}
{% if traspaso.estado == 'DOCUMENTOS' and not traspaso.documentos_obligatorios_generados and transfer_permissions['generar-tarjeta'] and transfer_permissions['generar-resguardo'] %}<form method="post" action="{{ get_base_url() }}traspasos/generar-documentos/{{ traspaso.id_traspaso }}" class="mt-3"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="btn btn-outline-primary" type="submit">Generar documentos obligatorios</button></form>{% endif %}
{% if traspaso.estado == 'FIRMA' and transfer_permissions.ejecutar %}{% if traspaso.listo_para_completar %}<form method="post" action="{{ get_base_url() }}traspasos/completar/{{ traspaso.id_traspaso }}" class="mt-3" onsubmit="return confirm('¿Confirmas completar el traspaso? Se actualizarán la unidad, ubicación y resguardo de todos los bienes y se registrarán sus movimientos.');"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="btn bi-btn-primary" type="submit">Completar traspaso</button></form>{% else %}<p class="alert alert-warning mt-3 mb-0">El traspaso se completará cuando se cargue la evidencia documental firmada de cada documento obligatorio.</p>{% endif %}{% endif %}
{% if traspaso.estado == 'COMPLETADO' and not traspaso.documentos_obligatorios_generados and transfer_permissions['generar-tarjeta'] and transfer_permissions['generar-resguardo'] %}<form method="post" action="{{ get_base_url() }}traspasos/generar-documentos/{{ traspaso.id_traspaso }}" class="mt-3"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="btn btn-outline-primary" type="submit">Generar documentos del expediente histórico</button></form>{% endif %}
</div></section>
<section class="card border-0 shadow-sm"><div class="card-header bg-white"><h2 class="h5 mb-0">Historial del expediente</h2></div><div class="list-group list-group-flush">{% for event in traspaso.eventos %}<div class="list-group-item"><div class="d-flex justify-content-between gap-2"><strong>{{ event.tipo_evento|replace({'_':' '})|title }}</strong><small class="text-muted">{{ event.fecha_evento|date('d/m/Y H:i:s') }}</small></div><div>{{ event.username|default('Usuario no disponible') }}{% if event.estado_anterior or event.estado_nuevo %} · {{ event.estado_anterior|default('—') }} → {{ event.estado_nuevo|default('—') }}{% endif %}</div>{% if event.motivo %}<small class="text-muted">{{ event.motivo }}</small>{% endif %}</div>{% else %}<div class="list-group-item text-muted">Sin eventos.</div>{% endfor %}</div></section>
</div><aside class="col-xl-4">
<section class="card border-0 shadow-sm mb-4"><div class="card-header bg-white"><h2 class="h5 mb-0">Autorización, entrega y recepción</h2></div><div class="card-body">
<p><strong>Autorización:</strong> {% if traspaso.fecha_autorizacion %}Autorizado por {{ traspaso.autorizador_username|default('usuario no disponible') }} · {{ traspaso.fecha_autorizacion|date('d/m/Y H:i') }}{% elseif traspaso.estado == 'RECHAZADO' %}Rechazado por {{ traspaso.rechazador_username|default('usuario no disponible') }} · {{ traspaso.motivo_rechazo }}{% elseif traspaso.tipo == 'MISMA_UNIDAD' %}No requerida{% else %}Pendiente{% endif %}</p>
<p><strong>Entrega:</strong> {% if traspaso.fecha_entrega %}{{ traspaso.tipo_entrega == 'ADMINISTRADOR' ? 'Administrador' : (traspaso.resguardante_entrega_nombre ~ ' ' ~ traspaso.resguardante_entrega_apellido) }} · registrada por {{ traspaso.confirma_entrega_username|default('usuario no disponible') }} · {{ traspaso.fecha_entrega|date('d/m/Y H:i') }}{% else %}Pendiente{% endif %}</p>
<p><strong>Recepción:</strong> {{ traspaso.fecha_recepcion ? traspaso.resguardante_destino_nombre ~ ' (registró ' ~ (traspaso.confirma_recepcion_username|default('usuario no disponible')) ~ ') · ' ~ (traspaso.fecha_recepcion|date('d/m/Y H:i')) : 'Pendiente' }}</p>
{% if traspaso.estado == 'PENDIENTE_AUTORIZACION' and is_transfer_admin %}<form method="post" action="{{ get_base_url() }}traspasos/autorizar/{{ traspaso.id_traspaso }}" class="mb-2"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="btn btn-success w-100" type="submit" {% if not transfer_permissions.autorizar %}disabled{% endif %}>Autorizar</button></form><form method="post" action="{{ get_base_url() }}traspasos/rechazar/{{ traspaso.id_traspaso }}" class="vstack gap-2"><input type="hidden" name="csrf" value="{{ csrf }}"><label class="form-label" for="rejectReason">Motivo del rechazo</label><textarea class="form-control" id="rejectReason" name="motivo" required maxlength="500"></textarea><button class="btn btn-outline-danger" type="submit" {% if not transfer_permissions.rechazar %}disabled{% endif %}>Rechazar</button></form>{% endif %}
{% if traspaso.estado == 'PENDIENTE_ENTREGA' and transfer_permissions['confirmar-entrega'] %}<hr><form method="post" action="{{ get_base_url() }}traspasos/confirmar-entrega/{{ traspaso.id_traspaso }}" class="vstack gap-2"><input type="hidden" name="csrf" value="{{ csrf }}"><label class="form-label" for="deliveryType">Persona que entrega</label><select class="form-select" id="deliveryType" name="tipo_entrega" required><option value="RESGUARDANTE_ACTUAL">Resguardante actual</option>{% if is_transfer_admin %}<option value="ADMINISTRADOR">Administrador</option>{% endif %}</select><small class="text-muted">La cuenta autenticada que registra la acción quedará identificada por separado.</small><button class="btn btn-outline-primary" type="submit">Confirmar entrega</button></form>{% endif %}
{% if traspaso.estado == 'PENDIENTE_RECEPCION' and transfer_permissions['confirmar-recepcion'] and transfer_permissions['ejecutar'] %}<hr><p>El receptor del expediente es <strong>{{ traspaso.resguardante_destino_nombre }}</strong> (C.S.P. {{ traspaso.resguardante_destino_csp }}). La cuenta activa registrará la confirmación en su nombre.</p><form method="post" action="{{ get_base_url() }}traspasos/confirmar-recepcion/{{ traspaso.id_traspaso }}"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="btn btn-primary w-100" type="submit">Confirmar recepción y completar</button></form>{% endif %}
{% if traspaso.estado in ['CREADO','PENDIENTE_AUTORIZACION','AUTORIZADO','PENDIENTE_ENTREGA','ENTREGA_CONFIRMADA','PENDIENTE_RECEPCION','DOCUMENTOS','FIRMA'] and transfer_permissions['cancelar'] %}<hr><form method="post" action="{{ get_base_url() }}traspasos/cancelar/{{ traspaso.id_traspaso }}" class="vstack gap-2" onsubmit="return confirm('¿Cancelar este expediente? Los bienes conservarán su custodia actual.');"><input type="hidden" name="csrf" value="{{ csrf }}"><label class="form-label" for="cancelReason">Motivo de cancelación (opcional)</label><input class="form-control" id="cancelReason" name="motivo" maxlength="500"><button class="btn btn-outline-danger" type="submit">Cancelar expediente</button></form>{% endif %}
{% if traspaso.estado in ['CREADO','AUTORIZADO'] and transfer_permissions['modificar'] %}<hr><form method="post" action="{{ get_base_url() }}traspasos/enviar/{{ traspaso.id_traspaso }}"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="btn btn-primary w-100" type="submit">{{ traspaso.estado == 'AUTORIZADO' ? 'Continuar a entrega' : 'Enviar a siguiente etapa' }}</button></form>{% endif %}
{% if traspaso.estado == 'COMPLETADO' and is_transfer_admin and transfer_permissions['crear'] %}<hr><form method="post" action="{{ get_base_url() }}traspasos/revertir/{{ traspaso.id_traspaso }}" class="vstack gap-2"><input type="hidden" name="csrf" value="{{ csrf }}"><label class="form-label" for="reverseReason">Motivo de reversión</label><textarea class="form-control" id="reverseReason" name="motivo" required maxlength="500"></textarea><button class="btn btn-outline-danger" type="submit">Crear expediente compensatorio</button></form>{% endif %}
</div></section>
</aside></div>
{% include 'includes/admin/inventory-bottom.twig' %}
