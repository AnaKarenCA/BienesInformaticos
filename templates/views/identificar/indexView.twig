{% include 'includes/admin/inventory-top.twig' %}
<section class="bi-hero mb-4"><h1>Identificar bien</h1><p>Busca por Inventario SICOPA, CI, número de serie, NIC/CEA o código de barras.</p><form method="get" class="row justify-content-center g-2"><div class="col-md-7"><input class="form-control form-control-lg" name="q" id="identInput" value="{{ consulta }}" placeholder="Ej. CI-202609221210401"></div><div class="col-auto"><button class="btn bi-btn-primary btn-lg">Buscar</button></div><div class="col-auto"><button class="btn btn-light btn-lg" type="button" id="usarCamara"><i class="fa-solid fa-camera"></i> Usar cámara</button></div></form><div id="cameraPanel" class="mt-3 d-none"><video id="cameraVideo" autoplay playsinline class="rounded" width="320"></video><p id="cameraStatus" class="small mt-2"></p></div></section>
{% if consulta and not bien %}<div class="alert alert-warning">No se encontró un bien con ese identificador.</div>{% endif %}{% if bien %}<div class="card shadow-sm border-0"><div class="card-header bg-white d-flex justify-content-between"><strong>{{ bien.clave_interna|default('—') }}</strong><span class="badge {{ bien.activo ? 'text-bg-success' : 'text-bg-secondary' }}">{{ bien.activo ? 'Activo' : 'Inactivo' }}</span></div><div class="card-body row"><div class="col-md-8"><h2 class="h4 bi-title">{{ bien.nombre_bien }}</h2><p class="text-muted">SICOPA: {{ bien.numero_inventario|default('—') }} · NIC/CEA: {{ bien.nic_cea|default('—') }} · Marca: {{ bien.marca_nombre|default('—') }} · Modelo: {{ bien.modelo_nombre|default('—') }} · Serie: {{ bien.numero_serie|default('—') }}</p><div class="bi-detail-grid"><div><small>Unidad</small><strong>{{ bien.codigo_ua }} · {{ bien.unidad_nombre }}</strong></div><div><small>Resguardante</small><strong>{{ bien.resguardante_nombre|default('Pendiente') }}</strong></div><div><small>Estado</small><strong>{{ bien.estado_nombre|default('—') }}</strong></div><div><small>Municipio</small><strong>{{ bien.municipio|default('—') }}</strong></div><div><small>Localidad</small><strong>{{ bien.localidad|default('—') }}</strong></div><div><small>Código de barras</small><strong>{{ bien.codigo_barra|default('—') }}</strong></div></div></div></div><div class="card-footer bg-white d-flex flex-wrap gap-2"><a class="btn btn-outline-secondary" href="{{ get_base_url() }}bienes/detalle/{{ bien.id_bien }}">Ver detalle</a><a class="btn bi-btn-primary" href="{{ get_base_url() }}bienes/editar/{{ bien.id_bien }}">Editar</a></div></div>{% endif %}
{% include 'includes/admin/inventory-bottom.twig' %}
